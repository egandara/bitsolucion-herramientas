@{
    ViewData["Title"] = "Laboratorio de IA Local (Ollama)";
}

<div class="container-fluid px-4 py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 m-0 fw-bold">🤖 Módulo de Pruebas: Ollama (Qwen 2.5)</h5>
                    <span class="badge bg-success px-3 py-2 shadow-sm">RTX 4060 Active</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Index" method="post" id="ollamaForm" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary text-uppercase small">Filtro / Enfoque Temporal del Prompt (Opcional):</label>
                            <input type="text" name="sistemaPrompt" class="form-control border-2" style="border-color: #dee2e6;"
                                   value="@(ViewBag.SistemaPrompt ?? "Enfócate en la lógica de extracción, las tablas afectadas y la cuadratura de datos.")" />
                            <div class="form-text text-muted">
                                <i class="bi bi-shield-lock"></i> El Glosario Corporativo (BCI = Banco de Crédito e Inversiones) se encuentra forzado de manera fija en el backend.
                            </div>
                        </div>

                        <div class="mb-3 p-3 bg-light rounded border border-2 border-dashed">
                            <label class="form-label fw-bold text-dark mb-1">📎 Adjuntar Script o Notebook (.py / .ipynb):</label>
                            <input type="file" name="archivo" class="form-control" accept=".py,.ipynb,.txt,.sql,.json" />
                            <div class="form-text text-muted mt-2">
                                El sistema extraerá el código automáticamente y aplicará las directivas de traducción de BIT Soluciones.
                            </div>
                            @if (ViewBag.ArchivoNombre != null)
                            {
                                <div class="mt-2 text-success fw-bold small">
                                    <i class="bi bi-file-earmark-check-fill"></i> Archivo procesado en memoria: @ViewBag.ArchivoNombre
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary text-uppercase small">Tu Prompt / Instrucciones Específicas:</label>
                            <textarea name="prompt" rows="4" class="form-control border-2" style="border-color: #dee2e6;"
                                      placeholder="Ej: Explica paso a paso qué tablas modifica este proceso normativo...">@ViewBag.Prompt</textarea>
                        </div>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger shadow-sm">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                            </div>
                        }

                        <button type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm" id="btnSubmit">
                            <span class="spinner-border spinner-border-sm d-none me-2" id="btnSpinner" role="status" aria-hidden="true"></span>
                            <span id="btnText">Procesar con IA Local</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow border-0 border-start border-4 border-primary">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="mb-0 fw-bold text-dark m-0">📝 Resultado de la Documentación</h5>
                    @if (ViewBag.Respuesta != null)
                    {
                        <button class="btn btn-sm btn-outline-primary fw-bold px-3" onclick="copyToClipboard()">
                            <i class="bi bi-clipboard"></i> Copiar Texto
                        </button>
                    }
                </div>
                <div class="card-body p-4 bg-white">
                    @if (ViewBag.Respuesta != null)
                    {
                        <div class="p-4 rounded-3 bg-white border">
                            <textarea id="resultadoRaw" style="display:none;">@ViewBag.Respuesta</textarea>

                            <div id="resultadoRenderizado" class="markdown-body" style="font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 1.12rem; line-height: 1.8; color: #1a1a1a;">
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted my-4">
                            <div class="mb-3" style="font-size: 2.5rem; opacity: 0.3;">📋</div>
                            <h5 class="fw-bold text-secondary">Sin contenido generado</h5>
                            <p class="small mb-0 text-secondary" style="max-width: 400px; margin: 0 auto;">Adjunta un archivo o ingresa tus instrucciones para procesar la información con la GPU local.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .markdown-body ul, .markdown-body ol {
        padding-left: 2rem;
        margin-bottom: 1.2rem;
    }

    .markdown-body li {
        margin-bottom: 0.5rem;
    }

    .markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4 {
        font-weight: 700;
        margin-top: 1.6rem;
        margin-bottom: 1rem;
        color: #111111;
    }

    .markdown-body h1 {
        font-size: 1.6rem;
        border-bottom: 1px solid #eee;
        padding-bottom: 0.3rem;
    }

    .markdown-body h2 {
        font-size: 1.4rem;
    }

    .markdown-body h3 {
        font-size: 1.2rem;
    }

    .markdown-body p {
        margin-bottom: 1rem;
    }

    .markdown-body strong {
        color: #000000;
        font-weight: 700;
    }

    .markdown-body code {
        background-color: #f1f3f5;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.9em;
        color: #d63384;
    }

    .markdown-body pre {
        background-color: #f8f9fa;
        padding: 1rem;
        border-radius: 6px;
        border: 1px solid #e9ecef;
        overflow-x: auto;
        margin-bottom: 1.2rem;
    }

        .markdown-body pre code {
            background-color: transparent;
            padding: 0;
            color: inherit;
            font-size: inherit;
        }
</style>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    var rawElement = document.getElementById('resultadoRaw');
    if (rawElement) {
    var rawText = rawElement.value;
    marked.setOptions({
    breaks: true,
    gfm: true
    });
    // Traduce la respuesta y renderiza HTML puro eliminando asteriscos literales
    document.getElementById('resultadoRenderizado').innerHTML = marked.parse(rawText);
    }
    });

    document.getElementById('ollamaForm').addEventListener('submit', function () {
    var btn = document.getElementById('btnSubmit');
    var spinner = document.getElementById('btnSpinner');
    var text = document.getElementById('btnText');

    spinner.classList.remove('d-none');
    text.innerText = 'Generando respuesta en GPU...';
    btn.classList.remove('btn-primary');
    btn.classList.add('btn-secondary');
    btn.disabled = true;
    });

    function copyToClipboard() {
    var text = document.getElementById('resultadoRaw').value;
    navigator.clipboard.writeText(text).then(function() {
    alert('¡Texto de la documentación copiado al portapapeles con éxito!');
    }, function(err) {
    console.error('Error al copiar el texto: ', err);
    });
    }
</script>
