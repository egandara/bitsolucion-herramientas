@model NotebookValidator.Web.Models.GestorProyectos.TareaProyecto
@{
    string initials = Model.UsuarioAsignado?.Email != null
        ? Model.UsuarioAsignado.Email.Substring(0, 2).ToUpper()
        : "?";

    string fullEmail = Model.UsuarioAsignado?.Email != null
            ? Model.UsuarioAsignado.Email.Split((char)64)[0]
            : "Sin Asignar";

    bool isDelayed = Model.Estado != "Terminada" &&
                     Model.FechaFinPlanificada.HasValue &&
                     Model.FechaFinPlanificada.Value.Date < DateTime.Now.Date;

    bool isStagnant = Model.Estado == "En Progreso" &&
                      Model.FechaInicioReal.HasValue &&
                      (DateTime.Now - Model.FechaInicioReal.Value).TotalDays > 3;

    int pId = Model.SubFase?.Fase?.ProyectoId ?? 0;
    string[] colores = { "#0dcaf0", "#20c997", "#ffc107", "#fd7e14", "#6f42c1", "#e83e8c" };
    string bordeColor = colores[pId % colores.Length];
}

<div class="k-card"
     data-id="@Model.Id"
     data-project-id="@pId"
     data-task-name="@Model.Nombre.Replace("\"", "").Replace("'", "")"
     data-user-alias="@fullEmail"
     style="border-left: 3px solid @bordeColor;">

    <div class="d-flex justify-content-between align-items-start mb-2">
        <div class="k-card-title pe-2" style="cursor: pointer; color: #0dcaf0; transition: color 0.2s;" onclick="openTaskDetails(@Model.Id)" title="Ver detalles y comentarios">
            @Model.Nombre
        </div>
        <div class="text-white-50 font-monospace" style="font-size: 0.65rem; background: rgba(255,255,255,0.05); padding: 2px 5px; border-radius: 4px;">@(Model.HorasEstimadas)h</div>
    </div>

    <div class="d-flex justify-content-between align-items-end mt-3">
        <div class="k-tag-project" title="@Model.SubFase?.Fase?.Proyecto?.Nombre">
            <i class="bi bi-folder2 me-1"></i>@Model.SubFase?.Fase?.Proyecto?.Nombre
        </div>

        <div class="d-flex align-items-center gap-1">
            <i class="bi bi-chat-text text-white-50 fs-6 ms-1 me-1" title="Comentarios"></i>

            @if (isDelayed)
            {
                <i class="bi bi-exclamation-triangle-fill text-danger fs-6 heartbeat-icon" title="Atrasada"></i>
            }
            @if (isStagnant)
            {
                <i class="bi bi-hourglass-bottom text-warning fs-6" title="Estancada"></i>
            }

            <div class="k-avatar ms-1" title="@fullEmail">@initials</div>
        </div>
    </div>
</div>
