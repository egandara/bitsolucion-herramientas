@{
    ViewData["Title"] = "Cuadratura de Datos";
}

<style>
    /* STEPPER MODERNO Y ELEGANTE */
    .stepper {
        display: flex;
        justify-content: space-between;
        margin-bottom: 30px;
        position: relative;
        padding: 0 10%;
    }

        .stepper::before {
            content: "";
            position: absolute;
            top: 22px;
            left: 10%;
            width: 80%;
            height: 3px;
            background: rgba(255, 255, 255, 0.1);
            z-index: 1;
            border-radius: 5px;
        }

    .step {
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: transparent !important;
        width: 120px;
    }

    .step-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #1e293b;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        font-weight: bold;
        font-size: 1.2rem;
        border: 6px solid #0f172a;
        transition: all 0.3s ease;
    }

    .step-label {
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
    }

    .step.completed .step-circle {
        background: #198754;
        color: white;
        border-color: #0f172a;
        box-shadow: 0 0 15px rgba(25, 135, 84, 0.3);
    }

    .step.completed .step-label {
        color: #198754;
    }

    .step.active .step-circle {
        background: #ffc107;
        color: #000;
        border-color: #0f172a;
        box-shadow: 0 0 20px rgba(255, 193, 7, 0.4);
        transform: scale(1.15);
    }

    .step.active .step-label {
        color: #ffc107;
        text-shadow: 0 0 10px rgba(255, 193, 7, 0.3);
    }

    /* === SWITCH ESTILO MULTI-AMBIENTE === */
    .mode-switch-container {
        display: flex;
        justify-content: center;
        margin-bottom: 40px;
    }

    .btn-switch {
        padding: 12px 30px;
        font-weight: 700;
        font-size: 1.05rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 260px;
    }

    .btn-switch-datos {
        border-radius: 8px 0 0 8px;
        border: 1px solid #ffc107;
        background-color: rgba(11, 13, 22, 0.6);
        color: #ffc107;
    }

        .btn-switch-datos.active {
            background-color: #ffc107;
            color: #000;
            box-shadow: 0 0 15px rgba(255, 193, 7, 0.2);
            z-index: 2;
        }

    .btn-switch-estruct {
        border-radius: 0 8px 8px 0;
        border: 1px solid #0dcaf0;
        background-color: rgba(11, 13, 22, 0.6);
        color: #0dcaf0;
        margin-left: -1px;
    }

        .btn-switch-estruct.active {
            background-color: #0dcaf0;
            color: #000;
            box-shadow: 0 0 15px rgba(13, 202, 240, 0.2);
            z-index: 2;
        }

    /* === RECUADROS INFORMATIVOS (NUEVO) === */
    .info-box {
        background-color: rgba(11, 13, 22, 0.6);
        border-radius: 8px;
        padding: 20px;
        margin-top: 20px;
        font-size: 0.85rem;
        color: #adb5bd;
    }

    .info-box-datos {
        border: 1px solid rgba(255, 193, 7, 0.6);
    }

    .info-box-estruct {
        border: 1px solid rgba(13, 202, 240, 0.6);
    }

    .info-box-title {
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: 12px;
    }

    .info-box-datos .info-box-title {
        color: #ffc107;
    }

    .info-box-estruct .info-box-title {
        color: #0dcaf0;
    }

    .info-box ol {
        margin-bottom: 15px;
        padding-left: 20px;
    }

    .info-box li {
        margin-bottom: 6px;
    }

    .info-important {
        background-color: rgba(255, 193, 7, 0.05);
        border: 1px solid rgba(255, 193, 7, 0.3);
        border-radius: 6px;
        padding: 10px 15px;
        color: #ffc107;
        font-size: 0.8rem;
    }

    /* DRAG & DROP */
    .drop-zone {
        border: 2px dashed #495057;
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
        background: rgba(255,255,255,0.02);
    }

        .drop-zone:hover, .drop-zone.dragover {
            border-color: #ffc107;
            background: rgba(255,193,7,0.05);
        }

        .drop-zone i {
            font-size: 2.5rem;
            color: #ffc107;
            margin-bottom: 10px;
        }

        .drop-zone p {
            margin: 0;
            color: #ffffff !important;
        }

    .file-name-display {
        color: #ffc107;
        font-weight: bold;
        margin-top: 10px;
        display: none;
    }

    .custom-placeholder::placeholder {
        color: #adb5bd !important;
        opacity: 1;
    }

    .form-check-label {
        color: #ffffff !important;
    }

    #loadingOverlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(15, 23, 42, 0.85);
        z-index: 10000;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(4px);
    }
</style>

<div class="container py-4">
    <div class="stepper mb-4">
        <div class="step active"><div class="step-circle">1</div><div class="step-label" id="lblStepCarga">Carga</div></div>
        <div class="step" id="stepMapeo"><div class="step-circle">2</div><div class="step-label">Mapeo</div></div>
        <div class="step" id="stepResultados"><div class="step-circle">3</div><div class="step-label">Resultados</div></div>
    </div>

    <h2 class="text-white mb-4 text-center fw-bold">Nueva Cuadratura de Archivos</h2>

    <div class="mode-switch-container">
        <button type="button" class="btn-switch btn-switch-datos active" id="btnModoDatos" onclick="cambiarModo('Datos')">
            <i class="bi bi-table me-2"></i>Cuadratura de Datos
        </button>
        <button type="button" class="btn-switch btn-switch-estruct" id="btnModoEstructura" onclick="cambiarModo('Estructura')">
            <i class="bi bi-layout-text-window me-2"></i>Validación de Estructura
        </button>
    </div>

    <form id="formCargaArchivos" action="@Url.Action("CargarArchivos", "Cuadratura")" method="post" enctype="multipart/form-data">
        <input type="hidden" id="modoAnalisis" name="modoAnalisis" value="Datos" />

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card bg-dark border-secondary h-100 shadow">
                    <div class="card-body">
                        <label class="text-white fw-bold mb-3 fs-5">Origen Datos A</label>
                        <div class="drop-zone" onclick="document.getElementById('file1').click()" id="dropZone1">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <p>Arrastra el archivo o haz clic aquí</p>
                            <div id="name1" class="file-name-display"></div>
                            <input type="file" id="file1" name="archivo1" hidden accept=".csv, .xlsx, .xls, .txt, .dat" required />
                        </div>

                        <div class="mt-3 bg-dark border border-secondary rounded p-2" id="hojasContainer1" style="display:none;">
                            <label class="text-white small fw-bold mb-1"><i class="bi bi-table text-info me-1"></i>Hoja a procesar:</label>
                            <select name="hoja1" id="hoja1" class="form-select form-select-sm bg-dark text-white border-secondary"></select>
                        </div>

                        <input type="text" name="alias1" class="form-control mt-3 bg-dark text-white border-secondary custom-placeholder" placeholder="Alias (Ej: Banco) - Opcional" />
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" name="tieneEncabezados1" value="true" id="chk1" checked>
                            <label class="form-check-label small" for="chk1">El archivo contiene encabezados</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card bg-dark border-secondary h-100 shadow">
                    <div class="card-body">
                        <label class="text-white fw-bold mb-3 fs-5">Origen Datos B</label>
                        <div class="drop-zone" onclick="document.getElementById('file2').click()" id="dropZone2">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <p>Arrastra el archivo o haz clic aquí</p>
                            <div id="name2" class="file-name-display"></div>
                            <input type="file" id="file2" name="archivo2" hidden accept=".csv, .xlsx, .xls, .txt, .dat" required />
                        </div>

                        <div class="mt-3 bg-dark border border-secondary rounded p-2" id="hojasContainer2" style="display:none;">
                            <label class="text-white small fw-bold mb-1"><i class="bi bi-table text-info me-1"></i>Hoja a procesar:</label>
                            <select name="hoja2" id="hoja2" class="form-select form-select-sm bg-dark text-white border-secondary"></select>
                        </div>

                        <input type="text" name="alias2" class="form-control mt-3 bg-dark text-white border-secondary custom-placeholder" placeholder="Alias (Ej: Sistema) - Opcional" />
                        <div class="form-check mt-3">
                            <input class="form-check-input" type="checkbox" name="tieneEncabezados2" value="true" id="chk2" checked>
                            <label class="form-check-label small" for="chk2">El archivo contiene encabezados</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RECUADROS INFORMATIVOS DINÁMICOS -->
        <div id="infoBoxDatos" class="info-box info-box-datos">
            <div class="info-box-title"><i class="bi bi-lightbulb-fill me-2"></i>¿Qué hace la Cuadratura de Datos?</div>
            <ol>
                <li>Compara <strong>fila por fila</strong> la información de dos archivos distintos.</li>
                <li>Requiere que definas "Llaves Primarias" en el siguiente paso para cruzar los registros de forma precisa.</li>
                <li>Identifica diferencias exactas en los valores, coincidencias y registros huérfanos (faltantes).</li>
            </ol>
            <div class="info-important">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>CASO DE USO:</strong> Ideal para validación de ETLs, migraciones de plataformas o conciliación de saldos donde el contenido de cada celda debe ser idéntico.
            </div>
        </div>

        <div id="infoBoxEstructura" class="info-box info-box-estruct" style="display: none;">
            <div class="info-box-title"><i class="bi bi-lightbulb-fill me-2"></i>¿Qué hace la Validación de Estructura?</div>
            <ol>
                <li>Analiza únicamente el <strong>esqueleto (metadata)</strong> de los archivos, ignorando los datos fila por fila.</li>
                <li>Infiere y compara los tipos de datos (Entero, Decimal, Fecha, Texto), delimitadores y codificación.</li>
                <li>Detecta columnas faltantes, sobrantes o cambios de formato de datos (ej. precisiones decimales).</li>
            </ol>
            <div class="info-important">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> <strong>CASO DE USO:</strong> Ideal para Contratos de Datos (Data Contracts) y para asegurar que un archivo origen cumple con el esquema estructural esperado antes de procesarlo.
            </div>
        </div>

        <div class="text-center mt-5">
            <button type="submit" id="btnSubmitForm" class="btn btn-warning btn-lg px-5 fw-bold shadow text-dark">
                Analizar y Mapear <i class="bi bi-arrow-right-circle ms-2"></i>
            </button>
        </div>
    </form>
</div>

<div id="loadingOverlay">
    <div class="spinner-border text-warning mb-3" style="width: 4rem; height: 4rem;" role="status"></div>
    <h3 class="text-white fw-bold" id="loadingTitle">Analizando archivos...</h3>
    <p class="text-light" id="loadingSub">Infiriendo similitudes. Por favor espera.</p>
</div>

<script>
    // === LÓGICA DE CAMBIO DE MODO ===
    function cambiarModo(modo) {
        document.getElementById('modoAnalisis').value = modo;
        const btnDatos = document.getElementById('btnModoDatos');
        const btnEstructura = document.getElementById('btnModoEstructura');
        const form = document.getElementById('formCargaArchivos');
        const btnSubmit = document.getElementById('btnSubmitForm');

        const stepMapeo = document.getElementById('stepMapeo');
        const stepResultados = document.getElementById('stepResultados');
        const loadingTitle = document.getElementById('loadingTitle');
        const loadingSub = document.getElementById('loadingSub');

        const boxDatos = document.getElementById('infoBoxDatos');
        const boxEstruct = document.getElementById('infoBoxEstructura');

        if (modo === 'Datos') {
            btnDatos.classList.add('active');
            btnEstructura.classList.remove('active');

            boxDatos.style.display = 'block';
            boxEstruct.style.display = 'none';

            btnSubmit.innerHTML = 'Analizar y Mapear <i class="bi bi-arrow-right-circle ms-2"></i>';
            btnSubmit.className = 'btn btn-warning btn-lg px-5 fw-bold shadow text-dark';
            form.action = '@Url.Action("CargarArchivos", "Cuadratura")';

            stepMapeo.style.display = 'flex';
            stepResultados.querySelector('.step-circle').innerText = '3';

            loadingTitle.innerText = 'Analizando archivos...';
            loadingSub.innerText = 'Infiriendo similitudes. Por favor espera.';

        } else {
            btnEstructura.classList.add('active');
            btnDatos.classList.remove('active');

            boxEstruct.style.display = 'block';
            boxDatos.style.display = 'none';

            btnSubmit.innerHTML = 'Analizar Estructuras <i class="bi bi-cpu ms-2"></i>';
            btnSubmit.className = 'btn btn-info btn-lg px-5 fw-bold shadow text-dark';
            form.action = '@Url.Action("ValidarEstructuras", "Cuadratura")';

            stepMapeo.style.display = 'none';
            stepResultados.querySelector('.step-circle').innerText = '2';

            loadingTitle.innerText = 'Validando Esquemas...';
            loadingSub.innerText = 'Extrayendo metadatos e infiriendo tipos de datos.';
        }
    }

    // === LÓGICA ORIGINAL DRAG & DROP ===
    function setupDropZone(inputId, zoneId, displayId, selectContainerId, selectId) {
        const input = document.getElementById(inputId);
        const zone = document.getElementById(zoneId);
        const display = document.getElementById(displayId);

        zone.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('dragover'); });
        zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
        zone.addEventListener('drop', (e) => {
            e.preventDefault();
            zone.classList.remove('dragover');
            if (e.dataTransfer.files.length) {
                input.files = e.dataTransfer.files;
                updateNameAndFetchSheets();
            }
        });
        input.addEventListener('change', updateNameAndFetchSheets);

        function updateNameAndFetchSheets() {
            if (input.files.length) {
                const file = input.files[0];
                display.innerText = "📄 " + file.name;
                display.style.display = 'block';
                zone.querySelector('p').style.display = 'none';

                const formData = new FormData();
                formData.append("archivo", file);

                fetch('@Url.Action("ObtenerHojasExcel", "Cuadratura")', {
                    method: 'POST',
                    body: formData
                })
                .then(r => r.json())
                .then(hojas => {
                    const select = document.getElementById(selectId);
                    const container = document.getElementById(selectContainerId);
                    select.innerHTML = '';

                    if(hojas.length > 0 && hojas[0] !== "Única") {
                        hojas.forEach(h => {
                            select.innerHTML += `<option value="${h}">${h}</option>`;
                        });
                        container.style.display = 'block';
                        container.classList.add('animate__animated', 'animate__fadeInDown');
                    } else {
                        container.style.display = 'none';
                    }
                });
            }
        }
    }

    setupDropZone('file1', 'dropZone1', 'name1', 'hojasContainer1', 'hoja1');
    setupDropZone('file2', 'dropZone2', 'name2', 'hojasContainer2', 'hoja2');

    document.getElementById('formCargaArchivos').addEventListener('submit', function () {
        if (this.checkValidity()) document.getElementById('loadingOverlay').style.display = 'flex';
    });
</script>
