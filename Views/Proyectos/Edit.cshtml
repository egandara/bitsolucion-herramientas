function validarLimitesPadreHijo() {
try {
let hayErrores = false;
const wrappers = document.querySelectorAll('.subfase-group-wrapper');

function setInputError(input, isError) {
if (!input) return;
if (isError) {
input.style.setProperty('border', '2px solid #ef4444', 'important');
input.style.setProperty('background-color', 'rgba(239, 68, 68, 0.15)', 'important');
input.style.setProperty('color', '#ff6b6b', 'important');
} else {
input.style.removeProperty('border');
input.style.removeProperty('background-color');
input.style.removeProperty('color');
}
}

wrappers.forEach(wrapper => {
const sfRow = wrapper.querySelector('.subfase-row-container');
if (!sfRow) return;

const sfIniInput = sfRow.querySelector('.input-inicio');
const sfFinInput = sfRow.querySelector('.input-fin');
const sfHorasInput = sfRow.querySelector('.input-horas');

const sfIniDate = (sfIniInput && sfIniInput.value) ? new Date(sfIniInput.value) : null;
const sfFinDate = (sfFinInput && sfFinInput.value) ? new Date(sfFinInput.value) : null;
const sfHorasVal = (sfHorasInput && sfHorasInput.value) ? parseFloat(sfHorasInput.value) : 0;

const tareas = wrapper.querySelectorAll('.tarea-row-container');
const lineasTiempoRecursos = {};

// ¡CORRECCIÓN! Contenedores para rastrear el Lapso/Span calendario
let minTaskStartStr = null;
let maxTaskEndStr = null;
let minTaskStart = null;
let maxTaskEnd = null;

tareas.forEach(tRow => {
const tIniInput = tRow.querySelector('.input-inicio');
const tFinInput = tRow.querySelector('.input-fin');
const selectResp = tRow.querySelector('.user-select');
const userId = selectResp ? selectResp.value : "";
const predId = tRow.querySelector('.input-predecesora-id').value;

const tIniDate = (tIniInput && tIniInput.value) ? new Date(tIniInput.value) : null;
const tFinDate = (tFinInput && tFinInput.value) ? new Date(tFinInput.value) : null;
let errorDetectado = false;

// Rastrear inicio y fin extremos
if (tIniDate && (!minTaskStart || tIniDate < minTaskStart)) {
minTaskStart = tIniDate; minTaskStartStr = tIniInput.value;
}
if (tFinDate && (!maxTaskEnd || tFinDate > maxTaskEnd)) {
maxTaskEnd = tFinDate; maxTaskEndStr = tFinInput.value;
}

// Alerta 1: Tareas que desbordan los límites estrictos del padre (si se especifican)
if (sfIniDate && tIniDate && tIniDate < sfIniDate) errorDetectado = true;
if (sfFinDate && tFinDate && tFinDate > sfFinDate) errorDetectado = true;

// Alerta 2: Tarea predecesora violada
if (predId && predId !== "0" && tIniDate) {
const predRow = document.querySelector(`[data-t-id="${predId}"]`);
if (predRow) {
const predFinStr = predRow.querySelector('.input-fin').value;
if (predFinStr && tIniDate < new Date(predFinStr)) {
errorDetectado = true;
}
}
}

// Alerta 3: Clonación de Recurso (Solapamiento)
if (userId && tIniDate && tFinDate) {
if (!lineasTiempoRecursos[userId]) lineasTiempoRecursos[userId] = [];
for (let bloque of lineasTiempoRecursos[userId]) {
if (tIniDate < bloque.end && tFinDate > bloque.start) {
errorDetectado = true;
}
}
lineasTiempoRecursos[userId].push({ start: tIniDate, end: tFinDate });
}

setInputError(tIniInput, errorDetectado);
setInputError(tFinInput, errorDetectado);
if (errorDetectado) hayErrores = true;
});

// ¡CORRECCIÓN! Validación del Lapso vs Horas estimadas
let spanHorasHabiles = 0;
if (minTaskStartStr && maxTaskEndStr) {
spanHorasHabiles = parseFloat(calcularHorasDesdeFechas(minTaskStartStr, maxTaskEndStr));
}

// Permitimos un mini gap de 0.1 por milisegundos perdidos en el redondeo
setInputError(sfHorasInput, spanHorasHabiles > (sfHorasVal + 0.1) && tareas.length > 0);
});

const btnSubmit = document.getElementById('btnSubmit');
const btnIcon = document.getElementById('iconSubmit');
if (btnSubmit) {
if (hayErrores) {
btnSubmit.disabled = true;
btnSubmit.classList.replace('btn-warning', 'btn-danger');
if(btnIcon) btnIcon.className = 'bi bi-shield-fill-x me-1';
} else {
btnSubmit.disabled = false;
btnSubmit.classList.replace('btn-danger', 'btn-warning');
if(btnIcon) btnIcon.className = 'bi bi-save me-1';
}
}
} catch (error) {
console.error("Error en validación:", error);
}
}

