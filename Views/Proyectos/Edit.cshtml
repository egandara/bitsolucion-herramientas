@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

    <script>
        // ========================================================
        // 1. CONFIGURACIONES GLOBALES Y DICCIONARIOS
        // ========================================================
        const clientesHorarios = @Html.Raw(ViewBag.ClientesHorariosJson ?? "[]");
        let activeSchedule = { entradaH: 9, entradaM: 0, salidaNormalH: 18, salidaNormalM: 0, salidaViernesH: 18, salidaViernesM: 0 };
        
        const feriadosDB = @Html.Raw(ViewBag.FeriadosJson ?? "[]");
        const feriadosMap = new Map();
        feriadosDB.forEach(f => {
            let d = f.Fecha.split('T')[0];
            feriadosMap.set(d, f.Motivo);
        });

        // ========================================================
        // CONTROL GLOBAL DE DEPENDENCIAS (NUEVO)
        // ========================================================
        let currentLinkingTarget = null;
        const DRAFT_KEY = '@(Model != null ? $"ProyectoEditDraftWBS_{Model.Id}" : "ProyectoDraftWBS")';
        window.currentDraggedUser = null;

        
        const usuariosOptions = `@if (usuariosBanco != null) { foreach (var user in usuariosBanco) { <option value="@user.Id">@user.Email</option> } }`;
        const fasesOptions = `@if (Model.Fases != null) { foreach (var f in Model.Fases.OrderBy(x => x.Orden)) { <option value="@f.NombreFase">@f.Orden. @f.NombreFase.Replace("_", " ")</option> } }`;

        // ========================================================
        // 2. FUNCIONES DE FECHAS Y HORARIOS HÁBILES
        // ========================================================
        function esInhabil(dateObj) {
            let day = dateObj.getDay();
            if (day === 0 || day === 6) return true; // Sábados y Domingos
            let isoStr = dateObj.getFullYear() + "-" + String(dateObj.getMonth() + 1).padStart(2, '0') + "-" + String(dateObj.getDate()).padStart(2, '0');
            return feriadosMap.has(isoStr); // Feriado
        }

        function calcularFechaFinLogica(startDate, hoursRemaining) {
            let date = new Date(startDate.getTime());
            let safety = 0;
            while (hoursRemaining > 0 && safety < 100) {
                safety++;
                if (esInhabil(date)) {
                    date.setDate(date.getDate() + 1);
                    date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
                    continue;
                }
                let dayOfWeek = date.getDay();
                let exitH = (dayOfWeek === 5) ? activeSchedule.salidaViernesH : activeSchedule.salidaNormalH; 
                let exitM = (dayOfWeek === 5) ? activeSchedule.salidaViernesM : activeSchedule.salidaNormalM;
                
                let endOfDay = new Date(date); endOfDay.setHours(exitH, exitM, 0, 0); 
                let startOfDay = new Date(date); startOfDay.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
                
                if (date < startOfDay) date = new Date(startOfDay);
                if (date >= endOfDay) { 
                    date.setDate(date.getDate() + 1); 
                    date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
                    continue; 
                }
                let msRemainingToday = endOfDay - date;
                let hoursRemainingToday = msRemainingToday / 3600000;
                
                if (hoursRemaining <= hoursRemainingToday) { 
                    date.setTime(date.getTime() + (hoursRemaining * 3600000)); 
                    hoursRemaining = 0;
                } else { 
                    hoursRemaining -= hoursRemainingToday; 
                    date.setDate(date.getDate() + 1); 
                    date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
                }
            }
            return date;
        }

        function snapToWorkingHours(d) {
            let date = new Date(d.getTime()); let safety = 0;
            while(safety < 30) {
                safety++;
                if (esInhabil(date)) {
                    date.setDate(date.getDate() + 1);
                    date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
                    continue;
                }
                let day = date.getDay();
                let exitH = (day === 5) ? activeSchedule.salidaViernesH : activeSchedule.salidaNormalH; 
                let exitM = (day === 5) ? activeSchedule.salidaViernesM : activeSchedule.salidaNormalM;
                
                let endOfDay = new Date(date); endOfDay.setHours(exitH, exitM, 0, 0); 
                let startOfDay = new Date(date); startOfDay.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
                
                if (date < startOfDay) { date = new Date(startOfDay); break; } 
                else if (date >= endOfDay) { 
                    date.setDate(date.getDate() + 1);
                    date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0); 
                    continue; 
                } else { break; }
            }
            return date;
        }

        function calcularHorasDesdeFechas(startStr, endStr) {
            if (!startStr || !endStr) return "";
            let dStart = new Date(startStr);
            let dEnd = new Date(endStr);
            if (dStart >= dEnd) return 0;
            let totalHoras = 0; let curr = new Date(dStart);
            while (curr < dEnd) {
                if (esInhabil(curr)) {
                    curr.setDate(curr.getDate() + 1);
                    curr.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
                    continue;
                }
                let dayOfWeek = curr.getDay();
                let exitH = (dayOfWeek === 5) ? activeSchedule.salidaViernesH : activeSchedule.salidaNormalH;
                let exitM = (dayOfWeek === 5) ? activeSchedule.salidaViernesM : activeSchedule.salidaNormalM;
                let endOfDay = new Date(curr); endOfDay.setHours(exitH, exitM, 0, 0);
                if (dEnd <= endOfDay) { totalHoras += (dEnd - curr) / 3600000; break; }
                else { 
                    totalHoras += (endOfDay - curr) / 3600000;
                    curr.setDate(curr.getDate() + 1); 
                    curr.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0); 
                }
            }
            return totalHoras.toFixed(1).replace('.0', '');
        }

        // ========================================================
        // 3. ESTRUCTURA WBS: CREACIÓN Y MANIPULACIÓN DEL DOM
        // ========================================================
        function inyectarFilaSubfase(nombre = "", fechaIni = "", fechaFin = "", responsableVal = "", horasVal = "") {
            const container = document.getElementById('wbs-container');
            const wrapper = document.createElement('div'); wrapper.className = 'subfase-group-wrapper';
            wrapper.innerHTML = `
                <div class="subfase-row-container row-data-entity">
                    <div class="drag-handle-sf" title="Arrastrar para reordenar"><i class="bi bi-list"></i></div>
                    <input type="hidden" class="input-sf-id" value="0" />
                    <div class="form-group-grid"><label class="text-warning">Fase Principal</label><select class="form-select text-white border-secondary input-fasepadre" required>${fasesOptions}</select></div>
                    <div class="form-group-grid"><label class="text-warning">Nombre Subfase</label><input type="text" class="form-control text-white border-secondary input-nombre" value="${nombre}" required /></div>
                    <div class="form-group-grid"><label>Inicio (Hora)</label><input type="datetime-local" class="form-control text-white border-secondary input-inicio" value="${fechaIni}" /></div>
                    <div class="form-group-grid"><label class="text-warning">Horas</label><input type="number" step="0.5" class="form-control text-warning border-secondary input-horas" min="0.5" value="${horasVal}" /></div>
                    <div class="form-group-grid"><label>Fin Estimado</label><input type="datetime-local" class="form-control text-white border-secondary input-fin" value="${fechaFin}" /></div>
                    <div class="form-group-grid"><label>Responsable</label><div class="d-flex align-items-center gap-1 w-100"><select class="form-select text-white border-secondary user-select" style="flex-grow: 1;"><option value="">-- Sin asignar --</option>${usuariosOptions}</select><button type="button" class="btn btn-sm btn-outline-info btn-ver-agenda" title="Ver disponibilidad" style="min-width: 32px; height: 32px;"><i class="bi bi-calendar3"></i></button><div class="paint-zone rounded d-flex align-items-center justify-content-center" title="Desliza para pintar" style="min-width: 32px; height: 32px; border: 2px dashed rgba(255,193,7, 0.4); cursor: crosshair;"><i class="bi bi-brush-fill text-warning opacity-75"></i></div></div></div>
                    <div class="actions-group">
                        <button type="button" class="btn btn-sm btn-outline-secondary border-0 btn-demote-sf" title="Convertir a Tarea"><i class="bi bi-arrow-right"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-danger border-0 btn-remove-subfase"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
                <div class="tareas-container"></div>
                <div class="ms-4 mt-2"><button type="button" class="btn btn-sm btn-link text-info text-decoration-none p-0 btn-add-tarea" style="font-size: 0.75rem;"><i class="bi bi-arrow-return-right me-1"></i>Añadir Tarea</button></div>
            `;
            container.appendChild(wrapper);
            if (responsableVal) wrapper.querySelector('.user-select').value = responsableVal;
            bindRowEvents(wrapper.querySelector('.subfase-row-container'));
            initSortableTareas(wrapper.querySelector('.tareas-container'));
            reindexAll(); 
            document.getElementById('tray-asignacion').classList.remove('d-none');
            return wrapper;
        }

function inyectarFilaTarea(wrapperGroup, nombre = "", fechaIni = "", fechaFin = "", responsableVal = "", horasVal = "", predecesoraId = 0, predecesoraNombre = "") {
const container = wrapperGroup.querySelector('.tareas-container');
if (!fechaIni && !fechaFin) {
const tareasExistentes = container.querySelectorAll('.tarea-row-container');
if (tareasExistentes.length > 0) {
const ultimaTarea = tareasExistentes[tareasExistentes.length - 1];
const finUltimaTarea = ultimaTarea.querySelector('.input-fin').value;
if (finUltimaTarea) {
fechaIni = finUltimaTarea;
let d = new Date(fechaIni);
let tzoffset = d.getTimezoneOffset() * 60000;
let dEnd = new Date(d.getTime() + 3600000);
fechaFin = new Date(dEnd - tzoffset).toISOString().slice(0, 16);
horasVal = "1";
}
} else {
const sfInicio = wrapperGroup.querySelector('.subfase-row-container .input-inicio').value;
if (sfInicio) fechaIni = sfInicio;
}
}

// Generamos un ID temporal único para el DOM si es nueva, útil para enlazarlas antes de guardar en BD
const tempId = "temp_" + Math.random().toString(36).substr(2, 9);

const row = document.createElement('div');
row.className = 'tarea-row-container row-data-entity';
row.setAttribute('data-t-id', tempId); // Atributo clave para identificarla en el DOM

// Renderizamos el badge si ya viene con dependencia (ej: restaurando borrador)
let badgeHtml = "";
if (predecesoraId && predecesoraNombre) {
badgeHtml = `
<span class="badge bg-dark border border-info text-info small d-inline-flex align-items-center gap-1" style="font-size: 0.65rem; padding: 4px 8px;">
<i class="bi bi-link-45deg"></i> ↳ Depende de: ${predecesoraNombre}
<i class="bi bi-x btn-remove-dependency text-danger font-bold" style="cursor: pointer; font-size: 0.8rem;" title="Eliminar dependencia"></i>
</span>
`;
}

row.innerHTML = `
<div class="drag-handle-t" title="Arrastrar para reordenar"><i class="bi bi-list"></i></div>
<input type="hidden" class="input-tarea-id" value="0" />
<input type="hidden" class="input-predecesora-id" value="${predecesoraId}" />

<div class="form-group-grid">
<label class="text-info"><i class="bi bi-check2-square me-1"></i>Nombre de la Tarea</label>
<input type="text" class="form-control text-white border-info input-nombre" value="${nombre}" required />
<div class="dependency-badge-container mt-1">${badgeHtml}</div>
</div>
<div class="form-group-grid"><label>Inicio (Hora)</label><input type="datetime-local" class="form-control text-white border-secondary input-inicio" value="${fechaIni}" /></div>
<div class="form-group-grid"><label class="text-info">Horas</label><input type="number" step="0.5" class="form-control text-info border-secondary input-horas" min="0.5" value="${horasVal}" /></div>
<div class="form-group-grid"><label>Fin Estimado</label><input type="datetime-local" class="form-control text-white border-secondary input-fin" value="${fechaFin}" /></div>
<div class="form-group-grid"><label>Responsable</label><div class="d-flex align-items-center gap-1 w-100"><select class="form-select text-white border-secondary user-select" style="flex-grow: 1;"><option value="">-- Sin asignar --</option>${usuariosOptions}</select><button type="button" class="btn btn-sm btn-outline-info btn-ver-agenda" title="Ver disponibilidad" style="min-width: 32px; height: 32px;"><i class="bi bi-calendar3"></i></button><div class="paint-zone rounded d-flex align-items-center justify-content-center" title="Desliza para pintar" style="min-width: 32px; height: 32px; border: 2px dashed rgba(13, 202, 240, 0.4); cursor: crosshair;"><i class="bi bi-brush-fill text-info opacity-75"></i></div></div></div>
<div class="actions-group">
<button type="button" class="btn btn-sm btn-outline-info border-0 btn-link-dependency" title="Vincular Dependencia (Predecesora)"><i class="bi bi-link-45deg"></i></button>
<button type="button" class="btn btn-sm btn-outline-secondary border-0 btn-promote-t" title="Convertir a Subfase"><i class="bi bi-arrow-left"></i></button>
<button type="button" class="btn btn-sm btn-outline-danger border-0 btn-remove-tarea"><i class="bi bi-x-circle"></i></button>
</div>
`;
container.appendChild(row);
if (responsableVal) row.querySelector('.user-select').value = responsableVal;
bindRowEvents(row);
reindexAll();
}

        // ========================================================
        // 4. SANGRÍA, MANIPULACIÓN Y EFECTO CASCADA
        // ========================================================
        function demoteSubfaseToTarea(wrapper) {
            const prevWrapper = wrapper.previousElementSibling;
            if (!prevWrapper || !prevWrapper.classList.contains('subfase-group-wrapper')) {
                toastr.warning("No hay una subfase arriba a la cual asignarle esta tarea.");
                return;
            }

            const sfRow = wrapper.querySelector('.subfase-row-container');
            const nombre = sfRow.querySelector('.input-nombre').value;
            const ini = sfRow.querySelector('.input-inicio').value;
            const fin = sfRow.querySelector('.input-fin').value;
            const horas = sfRow.querySelector('.input-horas').value;
            const resp = sfRow.querySelector('.user-select').value;

            inyectarFilaTarea(prevWrapper, nombre, ini, fin, resp, horas);

            const tareasChild = wrapper.querySelectorAll('.tarea-row-container');
            tareasChild.forEach(tRow => {
                const tNombre = tRow.querySelector('.input-nombre').value;
                const tIni = tRow.querySelector('.input-inicio').value;
                const tFin = tRow.querySelector('.input-fin').value;
                const tHoras = tRow.querySelector('.input-horas').value;
                const tResp = tRow.querySelector('.user-select').value;
                inyectarFilaTarea(prevWrapper, tNombre, tIni, tFin, tResp, tHoras);
            });

            wrapper.remove();
            reindexAll();
            actualizarTermometro();
            guardarBorradorSilencioso();
        }

        function promoteTareaToSubfase(tRow) {
            const currentWrapper = tRow.closest('.subfase-group-wrapper');
            const nombre = tRow.querySelector('.input-nombre').value;
            const ini = tRow.querySelector('.input-inicio').value;
            const fin = tRow.querySelector('.input-fin').value;
            const horas = tRow.querySelector('.input-horas').value;
            const resp = tRow.querySelector('.user-select').value;

            tRow.remove();

            const newWrapper = inyectarFilaSubfase(nombre, ini, fin, resp, horas);
            currentWrapper.after(newWrapper);

            reindexAll();
            actualizarTermometro();
            guardarBorradorSilencioso();
        }

function aplicarCascadaSubfase(wrapperGroup) {
try {
if (!wrapperGroup) return;
const sfRow = wrapperGroup.querySelector('.subfase-row-container');
let sfStartStr = sfRow.querySelector('.input-inicio').value;
if (!sfStartStr) return;

function formatDatetimeLocal(d) {
let tzoffset = (new Date()).getTimezoneOffset() * 60000;
return (new Date(d - tzoffset)).toISOString().slice(0, 16);
}

const lastEndPerResource = {};
const tareas = wrapperGroup.querySelectorAll('.tarea-row-container');

tareas.forEach(tRow => {
const tIni = tRow.querySelector('.input-inicio');
const tFin = tRow.querySelector('.input-fin');
const tHoras = tRow.querySelector('.input-horas');
const selectResp = tRow.querySelector('.user-select');
const userId = selectResp ? selectResp.value : "";
const predId = tRow.querySelector('.input-predecesora-id').value;

let baseStart = new Date(sfStartStr);

// 1. Hereda el último bloque de tiempo de SU desarrollador
if (userId && lastEndPerResource[userId]) {
baseStart = new Date(lastEndPerResource[userId]);
}

// 2. Compara con el tiempo de su tarea Predecesora (Toma el Max Time)
if (predId && predId !== "0") {
const predRow = document.querySelector(`[data-t-id="${predId}"]`);
if (predRow) {
const predFinStr = predRow.querySelector('.input-fin').value;
if (predFinStr) {
const predFinDate = new Date(predFinStr);
if (predFinDate > baseStart) {
baseStart = predFinDate;
}
}
}
}

// 3. ¡CORRECCIÓN! Respeta si el usuario la movió manualmente hacia el futuro
let currentManualStart = tIni.value ? new Date(tIni.value) : null;
if (currentManualStart && currentManualStart > baseStart) {
baseStart = currentManualStart;
}

let snappedStart = snapToWorkingHours(baseStart);
let horasVal = parseFloat(tHoras.value) || 1;
let dEnd = calcularFechaFinLogica(snappedStart, horasVal);

if (dEnd) {
tIni.value = formatDatetimeLocal(snappedStart);
tFin.value = formatDatetimeLocal(dEnd);

if (userId) {
lastEndPerResource[userId] = formatDatetimeLocal(dEnd);
}
}

tRow.style.boxShadow = 'inset 0 0 15px rgba(13, 202, 240, 0.4)';
setTimeout(() => tRow.style.boxShadow = '', 600);
});

validarLimitesPadreHijo();
guardarBorradorSilencioso();
} catch(e) { console.error("Error en cascada multirecurso:", e); }
}

        // ========================================================
        // 5. VALIDACIÓN, REINDEXACIÓN Y MINI-CALENDARIO AJAX
        // ========================================================
        async function verAgendaUsuario(selectElement) {
            if (!selectElement) return;
            const usuarioId = selectElement.value;
            if (!usuarioId) {
                toastr.warning("Selecciona un responsable primero para inspeccionar su agenda.");
                return;
            }

            const modalNode = document.getElementById('modalAgendaUsuario');
            const modalInstance = new bootstrap.Modal(modalNode);
            
            const cargando = document.getElementById('agendaCargando');
            const lista = document.getElementById('agendaLista');
            
            cargando.classList.remove('d-none');
            lista.innerHTML = '';
            
            modalInstance.show();
            
            try {
                let response = await fetch(`/Proyectos/ObtenerAgendaUsuario?usuarioId=${usuarioId}`);
                let agenda = await response.json();
                
                cargando.classList.add('d-none');
                
                if (!agenda || agenda.length === 0) {
                    lista.innerHTML = `<div class="text-center py-4 text-white-50 small"><i class="bi bi-calendar-check text-success me-2 fs-5"></i> El usuario no registra tareas ni subfases activas. ¡Totalmente Disponible!</div>`;
                    return;
                }
                
                agenda.forEach(item => {
                    const badgeColor = item.tipo === 'Subfase' ? 'bg-warning text-dark' : 'bg-info text-dark';
                    const block = document.createElement('div');
                    block.className = 'p-2 rounded border border-secondary mb-2';
                    block.style.backgroundColor = '#171b2e';
                    block.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge ${badgeColor} small" style="font-size:0.65rem; font-weight:bold;">${item.tipo}</span>
                            <span class="text-white-50 font-monospace" style="font-size:0.7rem;"><i class="bi bi-clock me-1"></i>${item.inicio} al ${item.fin.split(' ')[1]}</span>
                        </div>
                        <div class="small fw-bold text-white mb-1">${item.nombre}</div>
