function inyectarFilaTarea(wrapperGroup, nombre = "", fechaIni = "", fechaFin = "", responsableVal = "", horasVal = "") {
const container = wrapperGroup.querySelector('.tareas-container');

if (!fechaIni && !fechaFin) {
const tareasExistentes = container.querySelectorAll('.tarea-row-container');
if (tareasExistentes.length > 0) {
const ultimaTarea = tareasExistentes[tareasExistentes.length - 1];
const finUltimaTarea = ultimaTarea.querySelector('.input-fin').value;
if (finUltimaTarea) {
fechaIni = finUltimaTarea;
let d = new Date(fechaIni);
let tzoffset = d.getTimezoneOffset() * 60000;
let dEnd = new Date(d.getTime() + 3600000);
fechaFin = new Date(dEnd - tzoffset).toISOString().slice(0, 16);
horasVal = "1";
}
} else {
const sfInicio = wrapperGroup.querySelector('.subfase-row-container .input-inicio').value;
if (sfInicio) fechaIni = sfInicio;
}
}

const row = document.createElement('div'); row.className = 'tarea-row-container row-data-entity';
row.innerHTML = `
<div class="drag-handle-t" title="Arrastrar para reordenar"><i class="bi bi-list"></i></div>
<input type="hidden" class="input-tarea-id" value="0" />
<div class="form-group-grid"><label class="text-info"><i class="bi bi-check2-square me-1"></i>Nombre de la Tarea</label><input type="text" class="form-control text-white border-info input-nombre" value="${nombre}" required /></div>
<div class="form-group-grid"><label>Inicio (Hora)</label><input type="datetime-local" class="form-control text-white border-secondary input-inicio" value="${fechaIni}" /></div>
<div class="form-group-grid"><label class="text-info">Horas</label><input type="number" step="0.5" class="form-control text-info border-secondary input-horas" min="0.5" value="${horasVal}" /></div>
<div class="form-group-grid"><label>Fin Estimado</label><input type="datetime-local" class="form-control text-white border-secondary input-fin" value="${fechaFin}" /></div>
<div class="form-group-grid"><label>Responsable</label><div class="d-flex align-items-center gap-1 w-100"><select class="form-select text-white border-secondary user-select" style="flex-grow: 1;"><option value="">-- Sin asignar --</option>${usuariosOptions}</select><button type="button" class="btn btn-sm btn-outline-info btn-ver-agenda" title="Ver disponibilidad" style="min-width: 32px; height: 32px;"><i class="bi bi-calendar3"></i></button><div class="paint-zone rounded d-flex align-items-center justify-content-center" title="Desliza para pintar" style="min-width: 32px; height: 32px; border: 2px dashed rgba(13, 202, 240, 0.4); cursor: crosshair;"><i class="bi bi-brush-fill text-info opacity-75"></i></div></div></div>
<div class="actions-group">
<button type="button" class="btn btn-sm btn-outline-secondary border-0 btn-promote-t" title="Convertir a Subfase"><i class="bi bi-arrow-left"></i></button>
<button type="button" class="btn btn-sm btn-outline-danger border-0 btn-remove-tarea"><i class="bi bi-x-circle"></i></button>
</div>
`;
container.appendChild(row);
if (responsableVal) row.querySelector('.user-select').value = responsableVal;
bindRowEvents(row);
reindexAll();
}

