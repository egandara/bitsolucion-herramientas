@model NotebookValidator.Web.Models.GestorProyectos.Proyecto
@{
    ViewData["Title"] = "Crear Nuevo Proyecto";
    var usuariosBanco = ViewBag.UsuariosBanco as IEnumerable<dynamic>;
}

<style>
    /* ============================================================
           ESTRUCTURA LATERAL Y PANELES
           ============================================================ */
    .cal-sidebar-block {
        background-color: #111424 !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        border-radius: 10px;
        padding: 18px !important;
        margin-bottom: 16px;
    }

    .cal-sidebar-title {
        font-size: 0.8rem !important;
        font-weight: 700 !important;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #0dcaf0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding-bottom: 8px;
        margin-bottom: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-group-stacked {
        margin-bottom: 12px;
    }

        .form-group-stacked:last-child {
            margin-bottom: 0;
        }

        .form-group-stacked label {
            font-size: 0.72rem !important;
            color: rgba(255, 255, 255, 0.4) !important;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px !important;
            font-weight: bold;
        }

    .btn-auto-calcular {
        font-size: 0.65rem !important;
        padding: 2px 8px !important;
        border-radius: 6px !important;
        font-family: ui-monospace, monospace;
    }

    /* ============================================================
           GRID EXTENDIDO PARA SUBFASES Y TAREAS (WBS)
           ============================================================ */
    .subfase-group-wrapper {
        background-color: rgba(255, 255, 255, 0.01);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        padding: 14px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .subfase-row-container {
        display: grid !important;
        grid-template-columns: auto 1.5fr 3.5fr 1.5fr 0.8fr 1.5fr 2.5fr auto !important;
        gap: 12px !important;
        align-items: end !important;
        margin-bottom: 8px;
    }

    .tarea-row-container {
        display: grid !important;
        grid-template-columns: auto 3.5fr 1.5fr 0.8fr 1.5fr 2.5fr auto !important;
        gap: 12px !important;
        align-items: end !important;
        background-color: rgba(13, 202, 240, 0.03);
        border-left: 3px solid #0dcaf0;
        border-radius: 6px;
        padding: 10px 14px !important;
        margin-bottom: 8px;
        margin-left: 40px;
        transition: box-shadow 0.3s ease;
    }

    .form-group-grid {
        display: flex;
        flex-direction: column;
        width: 100% !important;
    }

        .form-group-grid label {
            font-size: 0.7rem !important;
            color: rgba(255, 255, 255, 0.4) !important;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px !important;
            white-space: nowrap;
        }

        .form-group-grid .form-control, .form-group-grid .form-select {
            width: 100% !important;
            padding: 6px 10px !important;
            font-size: 0.8rem !important;
            background-color: #171b2e !important;
            border: 1px solid rgba(255,255,255,0.08) !important;
            color: #f5f6fa !important;
            border-radius: 6px !important;
            text-overflow: ellipsis;
        }

    .input-horas {
        text-align: center;
    }

    .actions-group {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding-bottom: 4px;
    }

    .drag-handle-sf, .drag-handle-t {
        cursor: grab;
        color: rgba(255, 255, 255, 0.3);
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-bottom: 6px;
        transition: color 0.2s;
    }

        .drag-handle-sf:hover, .drag-handle-t:hover {
            color: #0dcaf0;
        }

        .drag-handle-sf:active, .drag-handle-t:active {
            cursor: grabbing;
        }

    .sticky-tray {
        position: sticky;
        top: 20px;
        z-index: 1020;
        background-color: rgba(33, 37, 41, 0.95) !important;
        backdrop-filter: blur(5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
        border-radius: 8px;
        transition: box-shadow 0.3s ease;
    }
</style>

<div class="container-fluid mt-3" style="max-width: 1500px !important;">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Volver</a>
        <div>
            <h1 class="h4 fw-bold mb-0 text-white" style="font-family: 'Poppins', sans-serif;">Crear Nuevo Proyecto</h1>
            <p class="mb-0 small text-white-50">El sistema orquestará las carpetas en Drive y registrará la gobernanza.</p>
        </div>
    </div>

    <form asp-action="Create" method="post" id="formCreateProject">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div id="draftAlert" class="alert alert-warning d-none align-items-center mb-4 shadow-sm" style="background-color: rgba(255, 193, 7, 0.1); border: 1px solid rgba(255, 193, 7, 0.4); color: #ffc107;">
            <i class="bi bi-life-preserver me-3 fs-3"></i>
            <div class="flex-grow-1">
                <strong class="text-white">Borrador de seguridad encontrado</strong><br />
                <span class="small text-white-50">Se detectaron datos no guardados de tu última sesión.</span>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-warning fw-bold text-dark" onclick="restaurarBorrador()">Recuperar Todo</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="descartarBorrador()">Descartar</button>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-8 col-xl-9">
                <div class="card p-4 border-0 h-100" style="background-color: #0b0d16; border-radius: 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
                    <h5 class="fw-bold text-warning mb-3 border-bottom border-secondary pb-2" style="font-size: 1rem;"><i class="bi bi-info-square me-2"></i>1. Información General y Configuración</h5>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label text-white small fw-bold">Nombre del Proyecto <span class="text-danger">*</span></label>
                            <input type="text" name="nombre" class="form-control bg-dark text-white border-secondary" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-white small fw-bold">Empresa / Cliente</label>
                            <select name="clienteId" id="selectClienteId" class="form-select bg-dark text-white border-secondary" asp-items="ViewBag.Clientes">
                                <option value="">-- Interno / Estándar --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-bold">Repositorio GitHub</label>
                            <div class="input-group input-group-sm"><span class="input-group-text bg-secondary text-white"><i class="bi bi-github"></i></span><input type="text" name="repositorioGitHub" class="form-control bg-dark text-white border-secondary" /></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white small fw-bold">Contraparte del Cliente</label>
                            <div class="input-group input-group-sm"><span class="input-group-text bg-secondary text-white"><i class="bi bi-person-badge"></i></span><input type="text" name="contraparteCliente" class="form-control bg-dark text-white border-secondary" /></div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-white small fw-bold">Descripción Corta</label>
                            <textarea name="descripcion" class="form-control bg-dark text-white border-secondary" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-xl-3">
                <div class="cal-sidebar-block mb-3">
                    <div class="cal-sidebar-title">
                        <span><i class="bi bi-calendar3 me-1"></i>2. Cronograma</span>
                        <button type="button" class="btn btn-outline-info btn-auto-calcular" onclick="sincronizarFechas()"><i class="bi bi-magic me-1"></i>Auto</button>
                    </div>
                    <div class="form-group-stacked"><label>Fecha de Inicio</label><input type="date" name="fechaInicio" id="gFechaInicio" class="form-control bg-dark text-white border-secondary" /></div>
                    <div class="form-group-stacked mt-3"><label>Fin Estimado (Cierre)</label><input type="date" name="fechaFinEstimada" id="gFechaFin" class="form-control bg-dark text-white border-secondary" /></div>
                    <div class="form-group-stacked mt-3"><label>Paso a Producción</label><input type="date" name="fechaPasoProduccion" class="form-control bg-dark text-white border-secondary" /></div>
                </div>

                <div class="cal-sidebar-block mb-0">
                    <div class="cal-sidebar-title"><span><i class="bi bi-shield-check me-1"></i>3. Calidad QA</span></div>
                    <div class="form-group-stacked"><label>Máximo Warnings Perm.</label><input type="number" name="maxWarningsPermitidos" class="form-control bg-dark text-white border-secondary text-center" min="0" value="0" required /></div>
                    <div class="form-group-stacked mt-3"><label>Máximo Infos Perm.</label><input type="number" name="maxInfosPermitidos" class="form-control bg-dark text-white border-secondary text-center" min="0" value="0" required /></div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card p-4 border-0 mb-4" style="background-color: #0b0d16; border-radius: 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <div><h5 class="fw-bold text-light mb-0" style="font-size: 1rem;"><i class="bi bi-diagram-3-fill me-2"></i>4. Estructura WBS (Subfases y Tareas)</h5></div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-info fw-bold" onclick="auditarYSanitizarCronograma(0)" title="Detecta fechas en días no hábiles y las ajusta"><i class="bi bi-shield-check me-1"></i> Sanitizar Fechas</button>
                            <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#modalDomino"><i class="bi bi-calendar-range"></i> Dominó</button>
                            <button type="button" class="btn btn-sm btn-outline-success shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#modalPegadoInteligente"><i class="bi bi-magic me-1"></i> Pegar Excel</button>
                            <button type="button" class="btn btn-sm btn-outline-light" id="btnAddSubfase"><i class="bi bi-plus-lg"></i> Añadir Subfase</button>
                        </div>
                    </div>

                    <div id="tray-asignacion" class="border border-info border-opacity-25 p-3 mb-4 d-none sticky-tray">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-cursor-fill text-info me-2"></i><span class="text-white small fw-bold me-auto">Bandeja de Asignación Rápida (Flotante)</span>
                        </div>
                        <div class="d-flex flex-wrap gap-3 mt-2 px-1 pb-2">
                            @if (usuariosBanco != null)
                            {
                                foreach (var user in usuariosBanco)
                                {
                                    <div class="badge bg-secondary border border-secondary text-white draggable-user shadow-sm position-relative" draggable="true" data-uid="@user.Id" style="cursor: grab; font-size: 0.75rem; padding: 6px 12px; user-select: none;">
                                        <i class="bi bi-grip-vertical me-1 opacity-50"></i>@user.Email.Split('@')[0]
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark border border-secondary task-counter d-none" id="counter_@user.Id" style="font-size: 0.6rem; z-index: 5;">0</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div id="wbs-container" class="mb-2 d-flex flex-column"></div>
                </div>

                <div class="card p-4 border-0 mb-4" style="background-color: #0b0d16; border-radius: 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
                    <h5 class="fw-bold text-success mb-3 border-bottom border-secondary pb-2" style="font-size: 1rem;"><i class="bi bi-people me-2"></i>5. Asignación de Equipo Global</h5>
                    <div class="bg-dark border border-secondary p-3" style="border-radius: 6px; max-height: 200px; overflow-y: auto;">
                        @if (usuariosBanco != null)
                        {
                            foreach (var user in usuariosBanco)
                            {
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" name="usuariosAsignadosIds" value="@user.Id" id="user_@user.Id">
                                    <label class="form-check-label text-white small" for="user_@user.Id">@user.Email</label>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="text-end mb-5">
                    <button type="submit" class="btn btn-warning px-5 py-3 fw-bold shadow" id="btnSubmit" style="border-radius: 10px; font-size: 1.1rem;">
                        <span id="spinnerSubmit" class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span><i class="bi bi-rocket-takeoff me-1" id="iconSubmit"></i> Orquestar y Crear Proyecto
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal fade" id="modalDomino" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-sm modal-dialog-centered"><div class="modal-content text-white" style="background-color: #0b0d16; border: 1px solid #ffc107;"><div class="modal-header border-secondary p-3"><h6 class="modal-title fw-bold text-warning"><i class="bi bi-calendar-range me-2"></i>Desplazar Fechas Inteligente</h6><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><div class="modal-body p-3" style="background-color: #07091e;"><label class="text-white-50 small mb-2 d-block">¿Cuántos días de desplazamiento?</label><div class="input-group input-group-sm mb-2"><input type="number" id="inputDominoDias" class="form-control bg-dark text-white border-warning text-center" placeholder="Ej: 7" /><span class="input-group-text bg-secondary border-warning text-white">días</span></div><small class="text-success" style="font-size:0.65rem;"><i class="bi bi-info-circle me-1"></i>Evita automáticamente fines de semana.</small></div><div class="modal-footer border-secondary p-2"><button type="button" class="btn btn-sm btn-outline-light" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-sm btn-warning fw-bold" onclick="ejecutarEfectoDomino()">Aplicar Cascada</button></div></div></div></div>
<div class="modal fade" id="modalPegadoInteligente" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content text-white" style="background-color: #0b0d16; border: 1px solid #198754;"><div class="modal-header border-secondary"><h5 class="modal-title fw-bold text-success">Importación Inteligente</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><div class="modal-body px-4 py-4" style="background-color: #07091e;"><p class="text-white-50 small mb-2"><i class="bi bi-info-circle text-info me-1"></i> Tip: Si las celdas comienzan con un espacio o tabulación, serán consideradas Tareas bajo la última Subfase.</p><textarea id="txtPegadoMasivo" class="form-control form-control-sm bg-dark text-white font-monospace border-success" rows="8" placeholder="Pega tus filas aquí..."></textarea></div><div class="modal-footer border-secondary"><button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-success fw-bold" onclick="procesarPegadoHeuristico()">Procesar Filas</button></div></div></div></div>

<div class="modal fade" id="modalAgendaUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-white" style="background-color: #0b0d16; border: 1px solid #0dcaf0;">
            <div class="modal-header border-secondary p-3">
                <h6 class="modal-title fw-bold text-info"><i class="bi bi-calendar3 me-2"></i>Agenda y Disponibilidad del Recurso</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3" style="background-color: #07091e; max-height: 400px; overflow-y: auto;">
                <div id="agendaCargando" class="text-center py-3 d-none">
                    <div class="spinner-border spinner-border-sm text-info" role="status"></div>
                    <span class="ms-2 small text-white-50">Consultando agenda activa...</span>
                </div>
                <div id="agendaLista" class="d-flex flex-column gap-2"></div>
            </div>
            <div class="modal-footer border-secondary p-2">
                <button type="button" class="btn btn-sm btn-outline-light" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

    <script>
        // ========================================================
        // 1. CONFIGURACIONES GLOBALES Y DICCIONARIOS
        // ========================================================
        const clientesHorarios = @Html.Raw(ViewBag.ClientesHorariosJson ?? "[]");
        let activeSchedule = { entradaH: 9, entradaM: 0, salidaNormalH: 18, salidaNormalM: 0, salidaViernesH: 18, salidaViernesM: 0 };

        const feriadosDB = @Html.Raw(ViewBag.FeriadosJson ?? "[]");
        const feriadosMap = new Map();
        feriadosDB.forEach(f => {
        let d = f.Fecha.split('T')[0];
        feriadosMap.set(d, f.Motivo);
        });

        const DRAFT_KEY = 'ProyectoDraftWBS';
        window.currentDraggedUser = null;

        const usuariosOptions = `@if (usuariosBanco != null) { foreach (var user in usuariosBanco) {
        <option value="@user.Id">@user.Email</option>
    }
}
`;
const fasesOptions = `<option value="2_Desarrollo_Notebooks" selected>2. Desarrollo</option><option value="1_Diseño_Arquitectura">1. Diseño</option><option value="3_Pruebas_Certificacion">3. Pruebas QA</option><option value="4_Paso_A_Produccion">4. Producción</option>`;

// ========================================================
// 2. FUNCIONES DE FECHAS Y HORARIOS HÁBILES
// ========================================================
function esInhabil(dateObj) {
let day = dateObj.getDay();
if (day === 0 || day === 6) return true; // Sábados y Domingos
let isoStr = dateObj.getFullYear() + "-" + String(dateObj.getMonth() + 1).padStart(2, '0') + "-" + String(dateObj.getDate()).padStart(2, '0');
return feriadosMap.has(isoStr); // Feriado
}

function calcularFechaFinLogica(startDate, hoursRemaining) {
let date = new Date(startDate.getTime());
let safety = 0;
while (hoursRemaining > 0 && safety < 100) {
safety++;
if (esInhabil(date)) {
date.setDate(date.getDate() + 1);
date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
continue;
}
let dayOfWeek = date.getDay();
let exitH = (dayOfWeek === 5) ? activeSchedule.salidaViernesH : activeSchedule.salidaNormalH;
let exitM = (dayOfWeek === 5) ? activeSchedule.salidaViernesM : activeSchedule.salidaNormalM;

let endOfDay = new Date(date); endOfDay.setHours(exitH, exitM, 0, 0);
let startOfDay = new Date(date); startOfDay.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);

if (date < startOfDay) date = new Date(startOfDay);
if (date >= endOfDay) {
date.setDate(date.getDate() + 1);
date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
continue;
}
let msRemainingToday = endOfDay - date;
let hoursRemainingToday = msRemainingToday / 3600000;

if (hoursRemaining <= hoursRemainingToday) {
date.setTime(date.getTime() + (hoursRemaining * 3600000));
hoursRemaining = 0;
} else {
hoursRemaining -= hoursRemainingToday;
date.setDate(date.getDate() + 1);
date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
}
}
return date;
}

function snapToWorkingHours(d) {
let date = new Date(d.getTime()); let safety = 0;
while(safety < 30) {
safety++;
if (esInhabil(date)) {
date.setDate(date.getDate() + 1);
date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
continue;
}
let day = date.getDay();
let exitH = (day === 5) ? activeSchedule.salidaViernesH : activeSchedule.salidaNormalH;
let exitM = (day === 5) ? activeSchedule.salidaViernesM : activeSchedule.salidaNormalM;

let endOfDay = new Date(date); endOfDay.setHours(exitH, exitM, 0, 0);
let startOfDay = new Date(date); startOfDay.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);

if (date < startOfDay) { date = new Date(startOfDay); break; }
else if (date >= endOfDay) {
date.setDate(date.getDate() + 1);
date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
continue;
} else { break; }
}
return date;
}

// ========================================================
// 3. ESTRUCTURA WBS: CREACIÓN Y MANIPULACIÓN DEL DOM
// ========================================================
function inyectarFilaSubfase(nombre = "", fechaIni = "", fechaFin = "", responsableVal = "", horasVal = "") {
const container = document.getElementById('wbs-container');
const wrapper = document.createElement('div'); wrapper.className = 'subfase-group-wrapper';
wrapper.innerHTML = `
<div class="subfase-row-container row-data-entity">
<div class="drag-handle-sf" title="Arrastrar para reordenar"><i class="bi bi-list"></i></div>
<input type="hidden" class="input-sf-id" value="0" />
<div class="form-group-grid"><label class="text-warning">Fase Principal</label><select class="form-select text-white border-secondary input-fasepadre" required>${fasesOptions}</select></div>
<div class="form-group-grid"><label class="text-warning">Nombre Subfase</label><input type="text" class="form-control text-white border-secondary input-nombre" value="${nombre}" required /></div>
<div class="form-group-grid"><label>Inicio (Hora)</label><input type="datetime-local" class="form-control text-white border-secondary input-inicio" value="${fechaIni}" /></div>
<div class="form-group-grid"><label class="text-warning">Horas</label><input type="number" step="0.5" class="form-control text-warning border-secondary input-horas" min="0.5" value="${horasVal}" /></div>
<div class="form-group-grid"><label>Fin Estimado</label><input type="datetime-local" class="form-control text-white border-secondary input-fin" value="${fechaFin}" /></div>
<div class="form-group-grid"><label>Responsable</label><div class="d-flex align-items-center gap-1 w-100"><select class="form-select text-white border-secondary user-select" style="flex-grow: 1;"><option value="">-- Sin asignar --</option>${usuariosOptions}</select><button type="button" class="btn btn-sm btn-outline-info btn-ver-agenda" title="Ver disponibilidad" style="min-width: 32px; height: 32px;"><i class="bi bi-calendar3"></i></button><div class="paint-zone rounded d-flex align-items-center justify-content-center" title="Desliza para pintar" style="min-width: 32px; height: 32px; border: 2px dashed rgba(255,193,7, 0.4); cursor: crosshair;"><i class="bi bi-brush-fill text-warning opacity-75"></i></div></div></div>
