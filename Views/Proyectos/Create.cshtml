</div>

<div class="modal fade" id="modalDomino" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-sm modal-dialog-centered"><div class="modal-content text-white" style="background-color: #0b0d16; border: 1px solid #ffc107;"><div class="modal-header border-secondary p-3"><h6 class="modal-title fw-bold text-warning"><i class="bi bi-calendar-range me-2"></i>Desplazar Fechas Inteligente</h6><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><div class="modal-body p-3" style="background-color: #07091e;"><label class="text-white-50 small mb-2 d-block">¿Cuántos días de desplazamiento?</label><div class="input-group input-group-sm mb-2"><input type="number" id="inputDominoDias" class="form-control bg-dark text-white border-warning text-center" placeholder="Ej: 7" /><span class="input-group-text bg-secondary border-warning text-white">días</span></div><small class="text-success" style="font-size:0.65rem;"><i class="bi bi-info-circle me-1"></i>Evita automáticamente fines de semana.</small></div><div class="modal-footer border-secondary p-2"><button type="button" class="btn btn-sm btn-outline-light" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-sm btn-warning fw-bold" onclick="ejecutarEfectoDomino()">Aplicar Cascada</button></div></div></div></div>
<div class="modal fade" id="modalPegadoInteligente" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content text-white" style="background-color: #0b0d16; border: 1px solid #198754;"><div class="modal-header border-secondary"><h5 class="modal-title fw-bold text-success">Importación Inteligente</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><div class="modal-body px-4 py-4" style="background-color: #07091e;"><p class="text-white-50 small mb-2"><i class="bi bi-info-circle text-info me-1"></i> Tip: Si las celdas comienzan con un espacio o tabulación, serán consideradas Tareas bajo la última Subfase.</p><textarea id="txtPegadoMasivo" class="form-control form-control-sm bg-dark text-white font-monospace border-success" rows="8" placeholder="Pega tus filas aquí..."></textarea></div><div class="modal-footer border-secondary"><button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-success fw-bold" onclick="procesarPegadoHeuristico()">Procesar Filas</button></div></div></div></div>

@section Scripts {
    <script>
        const clientesHorarios = @Html.Raw(ViewBag.ClientesHorariosJson ?? "[]");
        let activeSchedule = { entradaH: 9, entradaM: 0, salidaNormalH: 18, salidaNormalM: 0, salidaViernesH: 18, salidaViernesM: 0 };
        document.getElementById('selectClienteId').addEventListener('change', function() {
            const val = this.value; const match = clientesHorarios.find(c => c.id === val);
            if(match) activeSchedule = match; else activeSchedule = { entradaH: 9, entradaM: 0, salidaNormalH: 18, salidaNormalM: 0, salidaViernesH: 18, salidaViernesM: 0 };
            document.querySelectorAll('.input-horas').forEach(inp => inp.dispatchEvent(new Event('input')));
        });

        document.getElementById('formCreateProject').addEventListener('submit', function () {
            document.querySelectorAll('.input-horas').forEach(inp => {
                if(inp.name && inp.value) {
                    const hidden = document.createElement('input'); hidden.type = 'hidden'; hidden.name = inp.name; hidden.value = inp.value.replace('.', ',');
                    inp.removeAttribute('name'); inp.parentNode.appendChild(hidden);
                }
            });
            var btn = document.getElementById('btnSubmit'); btn.disabled = true;
            document.getElementById('spinnerSubmit').classList.remove('d-none'); localStorage.removeItem(DRAFT_KEY);
        });

        window.currentDraggedUser = null;
        const usuariosOptions = `@if (usuariosBanco != null) { foreach (var user in usuariosBanco) {
        <option value="@user.Id">@user.Email</option>
    }
}
`;
const fasesOptions = `<option value="2_Desarrollo_Notebooks" selected>2. Desarrollo</option><option value="1_Diseño_Arquitectura">1. Diseño</option><option value="3_Pruebas_Certificacion">3. Pruebas QA</option><option value="4_Paso_A_Produccion">4. Producción</option>`;

document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll('.draggable-user').forEach(pill => {
        pill.addEventListener('dragstart', function(e) { window.currentDraggedUser = this.getAttribute('data-uid'); e.dataTransfer.setData('text/plain', window.currentDraggedUser); e.dataTransfer.effectAllowed = 'copy'; this.style.opacity = '0.5'; });
        pill.addEventListener('dragend', function(e) { window.currentDraggedUser = null; this.style.opacity = '1'; });
    });
    document.getElementById('selectClienteId').dispatchEvent(new Event('change'));
});

// ── MOTOR ALGORÍTMICO DE FECHAS (SANITIZADOR Y CASCADA) ──
function calcularFechaFinLogica(startDate, hoursRemaining) {
    let date = new Date(startDate.getTime()); let safety = 0;
    while (hoursRemaining > 0 && safety < 100) {
        safety++; let dayOfWeek = date.getDay();
        if (dayOfWeek === 0 || dayOfWeek === 6) { date.setDate(date.getDate() + (dayOfWeek === 6 ? 2 : 1)); date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0); continue; }
        let exitH = (dayOfWeek === 5) ? activeSchedule.salidaViernesH : activeSchedule.salidaNormalH; let exitM = (dayOfWeek === 5) ? activeSchedule.salidaViernesM : activeSchedule.salidaNormalM;
        let endOfDay = new Date(date); endOfDay.setHours(exitH, exitM, 0, 0); let startOfDay = new Date(date); startOfDay.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
        if (date < startOfDay) date = new Date(startOfDay);
        if (date >= endOfDay) { date.setDate(date.getDate() + 1); date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0); continue; }
        let msRemainingToday = endOfDay - date; let hoursRemainingToday = msRemainingToday / 3600000;
        if (hoursRemaining <= hoursRemainingToday) { date.setTime(date.getTime() + (hoursRemaining * 3600000)); hoursRemaining = 0; }
        else { hoursRemaining -= hoursRemainingToday; date.setDate(date.getDate() + 1); date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0); }
    }
    return date;
}

function snapToWorkingHours(d) {
    let date = new Date(d.getTime()); let safety = 0;
    while(safety < 10) {
        safety++; let day = date.getDay();
        if (day === 0 || day === 6) { date.setDate(date.getDate() + (day === 6 ? 2 : 1)); date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0); continue; }
        let exitH = (day === 5) ? activeSchedule.salidaViernesH : activeSchedule.salidaNormalH; let exitM = (day === 5) ? activeSchedule.salidaViernesM : activeSchedule.salidaNormalM;
        let endOfDay = new Date(date); endOfDay.setHours(exitH, exitM, 0, 0); let startOfDay = new Date(date); startOfDay.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0);
        if (date < startOfDay) { date = new Date(startOfDay); break; } else if (date >= endOfDay) { date.setDate(date.getDate() + 1); date.setHours(activeSchedule.entradaH, activeSchedule.entradaM, 0, 0); continue; } else { break; }
    }
    return date;
}

// Audita el cronograma buscando errores. Si dominoDays > 0, ejecuta un efecto cascada topológico.
function auditarYSanitizarCronograma(dominoDays = 0) {
    const rows = Array.from(document.querySelectorAll('.row-data-entity'));
    let parsedRows = [];

    rows.forEach(row => {
        const inpInicio = row.querySelector('.input-inicio'); const inpHoras = row.querySelector('.input-horas'); const inpFin = row.querySelector('.input-fin');
        if (inpInicio && inpInicio.value && inpHoras && inpHoras.value) {
            parsedRows.push({ rowEl: row, inpInicio: inpInicio, inpHoras: inpHoras, inpFin: inpFin, originalStart: new Date(inpInicio.value), hours: parseFloat(inpHoras.value) });
        }
    });

    if (parsedRows.length === 0) return;
    parsedRows.sort((a, b) => a.originalStart - b.originalStart); // Orden Topológico (Vital para la cascada)

    let cumulativeShiftMs = 0;
    let dominoMs = dominoDays * 24 * 60 * 60 * 1000;
    let totalCorrected = 0;

    function formatLocal(d) { let tzoffset = (new Date()).getTimezoneOffset() * 60000; return (new Date(d - tzoffset)).toISOString().slice(0, 16); }

    parsedRows.forEach(item => {
        // Sumamos el desplazamiento inicial (si lo hay) y la cascada de errores previos
        let baseStart = new Date(item.originalStart.getTime() + dominoMs + cumulativeShiftMs);
        let snappedStart = snapToWorkingHours(baseStart); // Si cae en domingo, lo mueve a Lunes.

        // Registramos el empuje extra para cascadaarlo a las tareas de abajo
        let extraShift = snappedStart.getTime() - baseStart.getTime();
        cumulativeShiftMs += extraShift;

        let newEnd = calcularFechaFinLogica(snappedStart, item.hours);
        let strStart = formatLocal(snappedStart); let strEnd = formatLocal(newEnd);

        let changed = false;
        if (item.inpInicio.value !== strStart) { item.inpInicio.value = strStart; changed = true; }
        if (item.inpFin.value !== strEnd) { item.inpFin.value = strEnd; changed = true; }

        if (changed) {
            totalCorrected++;
            item.rowEl.style.boxShadow = 'inset 0 0 15px rgba(25, 135, 84, 0.4)';
            setTimeout(() => item.rowEl.style.boxShadow = '', 600);
        }
    });

    sincronizarFechas(); guardarBorradorSilencioso();

    if (dominoDays > 0) {
        toastr.success(`Cascada aplicada: El cronograma se desplazó y se esquivaron ${totalCorrected} conflictos en fines de semana.`);
        bootstrap.Modal.getInstance(document.getElementById('modalDomino')).hide();
    } else {
        if (totalCorrected > 0) toastr.success(`¡Cronograma sanitizado! Se corrigieron ${totalCorrected} fechas que estaban en días u horas no hábiles.`);
        else toastr.info(`El cronograma está perfecto. No se encontraron fechas inválidas.`);
    }
}

function ejecutarEfectoDomino() {
    const dias = parseInt(document.getElementById('inputDominoDias').value, 10);
    if (isNaN(dias) || dias === 0) return;
    auditarYSanitizarCronograma(dias);
}

// ── INYECCIÓN UI ──
function inyectarFilaSubfase(nombre = "", fechaIni = "", fechaFin = "", responsableVal = "", horasVal = "") {
    const container = document.getElementById('wbs-container');
    const wrapper = document.createElement('div'); wrapper.className = 'subfase-group-wrapper';
    wrapper.innerHTML = `
        <div class="subfase-row-container row-data-entity">
            <input type="hidden" class="input-sf-id" value="0" />
            <div class="form-group-grid"><label class="text-warning">Fase Principal</label><select class="form-select text-white border-secondary input-fasepadre" required>${fasesOptions}</select></div>
            <div class="form-group-grid"><label class="text-warning">Nombre Subfase</label><input type="text" class="form-control text-white border-secondary input-nombre" value="${nombre}" required /></div>
            <div class="form-group-grid"><label>Inicio (Hora)</label><input type="datetime-local" class="form-control text-white border-secondary input-inicio" value="${fechaIni}" /></div>
            <div class="form-group-grid"><label class="text-warning">Horas</label><input type="number" step="0.5" class="form-control text-warning border-secondary input-horas" min="0.5" value="${horasVal}" /></div>
            <div class="form-group-grid"><label>Fin Estimado</label><input type="datetime-local" class="form-control text-white border-secondary input-fin" value="${fechaFin}" /></div>
            <div class="form-group-grid"><label>Responsable</label><div class="d-flex align-items-center gap-1 w-100"><select class="form-select text-white border-secondary user-select" style="flex-grow: 1;"><option value="">-- Sin asignar --</option>${usuariosOptions}</select><div class="paint-zone rounded d-flex align-items-center justify-content-center" title="Desliza para pintar" style="min-width: 32px; height: 32px; border: 2px dashed rgba(255,193,7, 0.4); cursor: crosshair;"><i class="bi bi-brush-fill text-warning opacity-75"></i></div></div></div>
            <div class="actions-group"><button type="button" class="btn btn-sm btn-outline-danger border-0 btn-remove-subfase"><i class="bi bi-trash"></i></button></div>
        </div>
        <div class="tareas-container"></div>
        <div class="ms-4 mt-2"><button type="button" class="btn btn-sm btn-link text-info text-decoration-none p-0 btn-add-tarea" style="font-size: 0.75rem;"><i class="bi bi-arrow-return-right me-1"></i>Añadir Tarea</button></div>
    `;
    container.appendChild(wrapper);
    if (responsableVal) wrapper.querySelector('.user-select').value = responsableVal;
    bindRowEvents(wrapper.querySelector('.subfase-row-container'));
    reindexAll(); document.getElementById('tray-asignacion').classList.remove('d-none');
    return wrapper;
}

function inyectarFilaTarea(wrapperGroup, nombre = "", fechaIni = "", fechaFin = "", responsableVal = "", horasVal = "") {
    const container = wrapperGroup.querySelector('.tareas-container');
    const row = document.createElement('div'); row.className = 'tarea-row-container row-data-entity';
    row.innerHTML = `
        <input type="hidden" class="input-tarea-id" value="0" />
        <div class="form-group-grid"><label class="text-info"><i class="bi bi-check2-square me-1"></i>Nombre de la Tarea</label><input type="text" class="form-control text-white border-info input-nombre" value="${nombre}" required /></div>
        <div class="form-group-grid"><label>Inicio (Hora)</label><input type="datetime-local" class="form-control text-white border-secondary input-inicio" value="${fechaIni}" /></div>
        <div class="form-group-grid"><label class="text-info">Horas</label><input type="number" step="0.5" class="form-control text-info border-secondary input-horas" min="0.5" value="${horasVal}" /></div>
        <div class="form-group-grid"><label>Fin Estimado</label><input type="datetime-local" class="form-control text-white border-secondary input-fin" value="${fechaFin}" /></div>
        <div class="form-group-grid"><label>Responsable</label><div class="d-flex align-items-center gap-1 w-100"><select class="form-select text-white border-secondary user-select" style="flex-grow: 1;"><option value="">-- Sin asignar --</option>${usuariosOptions}</select><div class="paint-zone rounded d-flex align-items-center justify-content-center" title="Desliza para pintar" style="min-width: 32px; height: 32px; border: 2px dashed rgba(13, 202, 240, 0.4); cursor: crosshair;"><i class="bi bi-brush-fill text-info opacity-75"></i></div></div></div>
        <div class="actions-group"><button type="button" class="btn btn-sm btn-outline-danger border-0 btn-remove-tarea"><i class="bi bi-x-circle"></i></button></div>
    `;
    container.appendChild(row);
    if (responsableVal) row.querySelector('.user-select').value = responsableVal;
    bindRowEvents(row); reindexAll();
}

function reindexAll() {
    const wrappers = document.querySelectorAll('.subfase-group-wrapper');
    wrappers.forEach((wrapper, sIdx) => {
        const sfRow = wrapper.querySelector('.subfase-row-container');
        if (sfRow) {
            const selFase = sfRow.querySelector('.input-fasepadre'); if(selFase) selFase.name = `Subfases[${sIdx}].FasePadre`;
            const inpNom = sfRow.querySelector('.input-nombre'); if(inpNom) inpNom.name = `Subfases[${sIdx}].Nombre`;
            const inpIni = sfRow.querySelector('.input-inicio'); if(inpIni) inpIni.name = `Subfases[${sIdx}].FechaInicio`;
            const inpFin = sfRow.querySelector('.input-fin'); if(inpFin) inpFin.name = `Subfases[${sIdx}].FechaFinEstimada`;
            const inpHrs = sfRow.querySelector('.input-horas'); if(inpHrs) inpHrs.name = `Subfases[${sIdx}].HorasEstimadas`;
            const selRes = sfRow.querySelector('.user-select'); if(selRes) selRes.name = `Subfases[${sIdx}].ResponsableId`;
        }
        const tRows = wrapper.querySelectorAll('.tarea-row-container');
        tRows.forEach((tRow, tIdx) => {
            const tId = tRow.querySelector('.input-tarea-id'); if(tId) tId.name = `Subfases[${sIdx}].Tareas[${tIdx}].Id`;
            const tNom = tRow.querySelector('.input-nombre'); if(tNom) tNom.name = `Subfases[${sIdx}].Tareas[${tIdx}].Nombre`;
            const tIni = tRow.querySelector('.input-inicio'); if(tIni) tIni.name = `Subfases[${sIdx}].Tareas[${tIdx}].FechaInicioPlanificada`;
            const tFin = tRow.querySelector('.input-fin'); if(tFin) tFin.name = `Subfases[${sIdx}].Tareas[${tIdx}].FechaFinPlanificada`;
            const tHrs = tRow.querySelector('.input-horas'); if(tHrs) tHrs.name = `Subfases[${sIdx}].Tareas[${tIdx}].HorasEstimadas`;
            const tRes = tRow.querySelector('.user-select'); if(tRes) tRes.name = `Subfases[${sIdx}].Tareas[${tIdx}].UsuarioAsignadoId`;
        });
    });
}

document.getElementById('btnAddSubfase').addEventListener('click', () => inyectarFilaSubfase());
document.getElementById('wbs-container').addEventListener('click', function(e) {
    if (e.target.closest('.btn-add-tarea')) { inyectarFilaTarea(e.target.closest('.subfase-group-wrapper')); }
    const btnRemoveSf = e.target.closest('.btn-remove-subfase');
    if (btnRemoveSf) { btnRemoveSf.closest('.subfase-group-wrapper').remove(); reindexAll(); actualizarTermometro(); guardarBorradorSilencioso(); if(document.querySelectorAll('.subfase-group-wrapper').length===0) document.getElementById('tray-asignacion').classList.add('d-none'); }
    const btnRemoveT = e.target.closest('.btn-remove-tarea');
    if (btnRemoveT) { btnRemoveT.closest('.tarea-row-container').remove(); reindexAll(); actualizarTermometro(); guardarBorradorSilencioso(); }
});

// ── ACTUALIZACIÓN INDIVIDUAL DE FILA ──
function bindRowEvents(row) {
    const inpInicio = row.querySelector('.input-inicio'); const inpHoras = row.querySelector('.input-horas'); const inpFin = row.querySelector('.input-fin'); const selectResp = row.querySelector('.user-select'); const paintZone = row.querySelector('.paint-zone');
    function formatDatetimeLocal(d) { let tzoffset = (new Date()).getTimezoneOffset() * 60000; return (new Date(d - tzoffset)).toISOString().slice(0, 16); }
    function actualizarUnaFila() {
        if (!inpInicio.value || !inpHoras.value) return;
        let date = calcularFechaFinLogica(new Date(inpInicio.value), parseFloat(inpHoras.value));
        if (date) { inpFin.value = formatDatetimeLocal(date); inpFin.style.backgroundColor = 'rgba(255, 193, 7, 0.2)'; setTimeout(() => inpFin.style.backgroundColor = '', 400); guardarBorradorSilencioso(); }
    }
    inpInicio.addEventListener('change', actualizarUnaFila); inpHoras.addEventListener('input', actualizarUnaFila);
    if (paintZone && selectResp) {
        paintZone.addEventListener('dragenter', function(e) { e.preventDefault(); if (window.currentDraggedUser && selectResp.value !== window.currentDraggedUser) { selectResp.value = window.currentDraggedUser; row.style.boxShadow = 'inset 0 0 20px rgba(25, 135, 84, 0.3)'; setTimeout(() => { row.style.boxShadow = ''; }, 500); const globalCb = document.getElementById('user_' + window.currentDraggedUser); if (globalCb) globalCb.checked = true; actualizarTermometro(); } });
        paintZone.addEventListener('dragover', e => e.preventDefault()); row.addEventListener('dragover', e => { e.preventDefault(); e.dataTransfer.dropEffect = 'copy'; });
        row.addEventListener('drop', function(e) { e.preventDefault(); const uid = e.dataTransfer.getData('text/plain'); if (uid) { selectResp.value = uid; const globalCb = document.getElementById('user_' + uid); if (globalCb) globalCb.checked = true; actualizarTermometro(); } });
    }
}

// ── PEGADO Y COMPONENTES EXTRAS ──
function procesarPegadoHeuristico() {
    const texto = document.getElementById('txtPegadoMasivo').value; if (!texto.trim()) return;
    function parseDate(fechaTexto) {
        if (!fechaTexto) return ""; let partes = fechaTexto.split(/[\/\-]/);
        if (partes.length === 3) { if (partes[0].length <= 2 && (partes[2].length === 4 || partes[2].length === 2)) { let year = partes[2].length === 2 ? "20" + partes[2] : partes[2]; return `${year}-${partes[1].padStart(2, '0')}-${partes[0].padStart(2, '0')}`; } if (partes[0].length === 4) return `${partes[0]}-${partes[1].padStart(2, '0')}-${partes[2].padStart(2, '0')}`; } return "";
    }
    const filas = texto.split('\n'); let agregadasSub = 0; let agregadasTar = 0; let currentWrapper = null;
    filas.forEach(fila => {
        if (!fila.trim()) return;
        const esTarea = fila.startsWith(' ') || fila.startsWith('\t'); const celdas = fila.split(/\t|\|/).map(c => c.trim());
        let nombre = celdas[0] || ""; let fecha1 = parseDate(celdas[1]); let fecha2 = parseDate(celdas[2]); let horasVal = celdas[3] ? celdas[3].replace(',', '.') : "";
        if (fecha1) fecha1 = `${fecha1}T${activeSchedule.entradaH.toString().padStart(2,'0')}:${activeSchedule.entradaM.toString().padStart(2,'0')}`;
        if (fecha2) fecha2 = `${fecha2}T${activeSchedule.salidaNormalH.toString().padStart(2,'0')}:${activeSchedule.salidaNormalM.toString().padStart(2,'0')}`;
        if (nombre) { if (esTarea && currentWrapper) { inyectarFilaTarea(currentWrapper, nombre, fecha1, fecha2, "", horasVal); agregadasTar++; } else { currentWrapper = inyectarFilaSubfase(nombre, fecha1, fecha2, "", horasVal); agregadasSub++; } }
    });
    if (agregadasSub > 0 || agregadasTar > 0) { toastr.success(`¡Se procesaron ${agregadasSub} Subfases y ${agregadasTar} Tareas con éxito!`); document.getElementById('txtPegadoMasivo').value = ''; bootstrap.Modal.getInstance(document.getElementById('modalPegadoInteligente')).hide(); actualizarTermometro(); }
}

function actualizarTermometro() {
    document.querySelectorAll('.task-counter').forEach(b => { b.textContent = '0'; b.classList.add('d-none'); });
    document.querySelectorAll('.draggable-user').forEach(p => { p.classList.remove('border-warning', 'border-danger'); p.classList.add('border-secondary'); });
    let conteo = {}; document.querySelectorAll('.user-select').forEach(sel => { if (sel.value) conteo[sel.value] = (conteo[sel.value] || 0) + 1; });
    for (let uid in conteo) {
        let total = conteo[uid]; let badge = document.getElementById('counter_' + uid); let pill = document.querySelector(`.draggable-user[data-uid="${uid}"]`);
        if (badge && pill) { badge.textContent = total; badge.classList.remove('d-none', 'bg-dark'); pill.classList.remove('border-secondary'); if (total >= 5) { badge.classList.add('bg-danger'); pill.classList.add('border-danger'); } else if (total >= 3) { badge.classList.add('bg-warning'); pill.classList.add('border-warning'); } else { badge.classList.add('bg-info'); pill.classList.add('border-info'); } }
    }
}

function sincronizarFechas() {
    const rows = document.querySelectorAll('.row-data-entity'); if (rows.length === 0) return;
    let minDate = null; let maxDate = null;
    rows.forEach(row => {
        const startInput = row.querySelector('.input-inicio'); const endInput = row.querySelector('.input-fin');
        if (startInput && startInput.value) { let d = new Date(startInput.value); if (!minDate || d < minDate) minDate = d; }
        if (endInput && endInput.value) { let d = new Date(endInput.value); if (!maxDate || d > maxDate) maxDate = d; }
    });
    const gStart = document.getElementById('gFechaInicio'); const gEnd = document.getElementById('gFechaFin');
    if (minDate) gStart.value = minDate.toISOString().split('T')[0]; if (maxDate) gEnd.value = maxDate.toISOString().split('T')[0];
    [gStart, gEnd].forEach(el => { const oldBg = el.style.backgroundColor; el.style.backgroundColor = 'rgba(13, 202, 240, 0.4)'; setTimeout(() => el.style.backgroundColor = oldBg, 500); });
}

const DRAFT_KEY = 'ProyectoDraftWBS';
function guardarBorradorSilencioso() {
    const form = document.getElementById('formCreateProject');
    const draft = { nombre: form.querySelector('input[name="nombre"]').value, clienteId: form.querySelector('select[name="clienteId"]').value, wrappers: [] };
    document.querySelectorAll('.subfase-group-wrapper').forEach(wrap => {
        const sfRow = wrap.querySelector('.subfase-row-container');
        const sfData = { nombre: sfRow.querySelector('.input-nombre').value, fInicio: sfRow.querySelector('.input-inicio').value, fFin: sfRow.querySelector('.input-fin').value, horas: sfRow.querySelector('.input-horas').value, resp: sfRow.querySelector('.user-select').value, tareas: [] };
        wrap.querySelectorAll('.tarea-row-container').forEach(tRow => { sfData.tareas.push({ nombre: tRow.querySelector('.input-nombre').value, fInicio: tRow.querySelector('.input-inicio').value, fFin: tRow.querySelector('.input-fin').value, horas: tRow.querySelector('.input-horas').value, resp: tRow.querySelector('.user-select').value }); });
        draft.wrappers.push(sfData);
    });
    localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
}

function restaurarBorrador() {
    const saved = localStorage.getItem(DRAFT_KEY); if (!saved) return; const draft = JSON.parse(saved);
    if(draft.nombre) document.querySelector('input[name="nombre"]').value = draft.nombre;
    if(draft.clienteId) { const sel = document.querySelector('select[name="clienteId"]'); sel.value = draft.clienteId; sel.dispatchEvent(new Event('change')); }
    if (draft.wrappers && draft.wrappers.length > 0) {
        document.getElementById('wbs-container').innerHTML = '';
        draft.wrappers.forEach(sf => { const w = inyectarFilaSubfase(sf.nombre, sf.fInicio, sf.fFin, sf.resp, sf.horas); if(sf.tareas) sf.tareas.forEach(t => inyectarFilaTarea(w, t.nombre, t.fInicio, t.fFin, t.resp, t.horas)); });
        actualizarTermometro();
    }
    document.getElementById('draftAlert').classList.add('d-none');
}

function descartarBorrador() { localStorage.removeItem(DRAFT_KEY); document.getElementById('draftAlert').classList.add('d-none'); }

document.addEventListener('DOMContentLoaded', () => {
    const saved = localStorage.getItem(DRAFT_KEY);
    if (saved) { const draft = JSON.parse(saved); if (draft.nombre || (draft.wrappers && draft.wrappers.length > 0)) document.getElementById('draftAlert').classList.remove('d-none'); }
    document.getElementById('formCreateProject').addEventListener('input', guardarBorradorSilencioso);
    document.getElementById('wbs-container').addEventListener('DOMSubtreeModified', guardarBorradorSilencioso);
});
</script>
