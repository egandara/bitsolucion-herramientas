// 4. SANGRÍA, MANIPULACIÓN Y EFECTO CASCADA
// ========================================================
function demoteSubfaseToTarea(wrapper) {
const prevWrapper = wrapper.previousElementSibling;
if (!prevWrapper || !prevWrapper.classList.contains('subfase-group-wrapper')) {
toastr.warning("No hay una subfase arriba a la cual asignarle esta tarea.");
return;
}

const sfRow = wrapper.querySelector('.subfase-row-container');
const nombre = sfRow.querySelector('.input-nombre').value;
const ini = sfRow.querySelector('.input-inicio').value;
const fin = sfRow.querySelector('.input-fin').value;
const horas = sfRow.querySelector('.input-horas').value;
const resp = sfRow.querySelector('.user-select').value;

inyectarFilaTarea(prevWrapper, nombre, ini, fin, resp, horas);

const tareasChild = wrapper.querySelectorAll('.tarea-row-container');
tareasChild.forEach(tRow => {
const tNombre = tRow.querySelector('.input-nombre').value;
const tIni = tRow.querySelector('.input-inicio').value;
const tFin = tRow.querySelector('.input-fin').value;
const tHoras = tRow.querySelector('.input-horas').value;
const tResp = tRow.querySelector('.user-select').value;
inyectarFilaTarea(prevWrapper, tNombre, tIni, tFin, tResp, tHoras);
});

wrapper.remove();
reindexAll();
actualizarTermometro();
guardarBorradorSilencioso();
}

function promoteTareaToSubfase(tRow) {
const currentWrapper = tRow.closest('.subfase-group-wrapper');
const nombre = tRow.querySelector('.input-nombre').value;
const ini = tRow.querySelector('.input-inicio').value;
const fin = tRow.querySelector('.input-fin').value;
const horas = tRow.querySelector('.input-horas').value;
const resp = tRow.querySelector('.user-select').value;

tRow.remove();

const newWrapper = inyectarFilaSubfase(nombre, ini, fin, resp, horas);
currentWrapper.after(newWrapper);

reindexAll();
actualizarTermometro();
guardarBorradorSilencioso();
}

function aplicarCascadaSubfase(wrapperGroup) {
try {
if (!wrapperGroup) return;
const sfRow = wrapperGroup.querySelector('.subfase-row-container');
let currentStartStr = sfRow.querySelector('.input-inicio').value;

if (!currentStartStr) return;

const tareas = wrapperGroup.querySelectorAll('.tarea-row-container');

tareas.forEach(tRow => {
const tIni = tRow.querySelector('.input-inicio');
const tFin = tRow.querySelector('.input-fin');
const tHoras = tRow.querySelector('.input-horas');

if(tIni.value !== currentStartStr) {
tIni.value = currentStartStr;
}

let horasVal = parseFloat(tHoras.value) || 1;
let dEnd = calcularFechaFinLogica(new Date(currentStartStr), horasVal);

if (dEnd) {
let tzoffset = dEnd.getTimezoneOffset() * 60000;
let endStr = new Date(dEnd - tzoffset).toISOString().slice(0, 16);
tFin.value = endStr;
currentStartStr = endStr;
}

tRow.style.boxShadow = 'inset 0 0 15px rgba(13, 202, 240, 0.4)';
setTimeout(() => tRow.style.boxShadow = '', 600);
});

validarLimitesPadreHijo();
guardarBorradorSilencioso();
} catch(e) { console.error("Error en cascada:", e); }
}

