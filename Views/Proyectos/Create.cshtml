function initSortableTareas(container) {
if (!container) return;
new Sortable(container, {
handle: '.drag-handle-t',
animation: 150,
ghostClass: 'bg-info',
onEnd: function(evt) {
reindexAll();
aplicarCascadaSubfase(evt.item.closest('.subfase-group-wrapper'));
}
});
}

function bindRowEvents(row) {
const inpInicio = row.querySelector('.input-inicio');
const inpHoras = row.querySelector('.input-horas');
const inpFin = row.querySelector('.input-fin');
const selectResp = row.querySelector('.user-select');
const paintZone = row.querySelector('.paint-zone');

function formatDatetimeLocal(d) {
let tzoffset = (new Date()).getTimezoneOffset() * 60000;
return (new Date(d - tzoffset)).toISOString().slice(0, 16);
}

function actualizarUnaFila() {
try {
if (inpInicio && inpHoras && inpInicio.value && inpHoras.value) {
let date = calcularFechaFinLogica(new Date(inpInicio.value), parseFloat(inpHoras.value));
if (date && inpFin) {
inpFin.value = formatDatetimeLocal(date);
inpFin.style.backgroundColor = 'rgba(255, 193, 7, 0.2)';
setTimeout(() => inpFin.style.backgroundColor = '', 400);
guardarBorradorSilencioso();
}
}
validarLimitesPadreHijo();
} catch(e) { console.error("Error calculando fechas:", e); }
}

if (inpInicio) inpInicio.addEventListener('change', actualizarUnaFila);
if (inpHoras) inpHoras.addEventListener('input', actualizarUnaFila);
if (inpFin) inpFin.addEventListener('change', validarLimitesPadreHijo);

if (paintZone && selectResp) {
paintZone.addEventListener('dragenter', function(e) {
e.preventDefault();
if (window.currentDraggedUser && selectResp.value !== window.currentDraggedUser) {
selectResp.value = window.currentDraggedUser;
row.style.boxShadow = 'inset 0 0 20px rgba(25, 135, 84, 0.3)';
setTimeout(() => { row.style.boxShadow = ''; }, 500);
const globalCb = document.getElementById('user_' + window.currentDraggedUser);
if (globalCb) globalCb.checked = true;
actualizarTermometro();
}
});
paintZone.addEventListener('dragover', e => e.preventDefault());
row.addEventListener('dragover', e => { e.preventDefault(); e.dataTransfer.dropEffect = 'copy'; });
row.addEventListener('drop', function(e) {
e.preventDefault();
const uid = e.dataTransfer.getData('text/plain');
if (uid) {
selectResp.value = uid;
const globalCb = document.getElementById('user_' + uid);
if (globalCb) globalCb.checked = true;
actualizarTermometro();
}
});
}
}

document.getElementById('wbs-container').addEventListener('click', function(e) {
if (e.target.closest('.btn-add-tarea')) { inyectarFilaTarea(e.target.closest('.subfase-group-wrapper')); }

const btnDemote = e.target.closest('.btn-demote-sf');
if (btnDemote) { demoteSubfaseToTarea(btnDemote.closest('.subfase-group-wrapper')); }

const btnPromote = e.target.closest('.btn-promote-t');
if (btnPromote) { promoteTareaToSubfase(btnPromote.closest('.tarea-row-container')); }

// 💡 NUEVO: Escuchar el botón del Mini-Calendario flotante
const btnAgenda = e.target.closest('.btn-ver-agenda');
