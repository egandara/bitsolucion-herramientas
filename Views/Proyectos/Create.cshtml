async function verAgendaUsuario(selectElement) {
if (!selectElement) return;
const usuarioId = selectElement.value;
if (!usuarioId) {
toastr.warning("Selecciona un responsable primero para inspeccionar su agenda.");
return;
}

const modalNode = document.getElementById('modalAgendaUsuario');
const modalInstance = new bootstrap.Modal(modalNode);

const cargando = document.getElementById('agendaCargando');
const lista = document.getElementById('agendaLista');

cargando.classList.remove('d-none');
lista.innerHTML = '';

modalInstance.show();

try {
let response = await fetch(`/Proyectos/ObtenerAgendaUsuario?usuarioId=${usuarioId}`);
let agenda = await response.json();

cargando.classList.add('d-none');

if (!agenda || agenda.length === 0) {
lista.innerHTML = `<div class="text-center py-4 text-white-50 small"><i class="bi bi-calendar-check text-success me-2 fs-5"></i> El usuario no registra tareas ni subfases activas. ¡Totalmente Disponible!</div>`;
return;
}

agenda.forEach(item => {
const badgeColor = item.tipo === 'Subfase' ? 'bg-warning text-dark' : 'bg-info text-dark';
const block = document.createElement('div');
block.className = 'p-2 rounded border border-secondary mb-2';
block.style.backgroundColor = '#171b2e';
block.innerHTML = `
<div class="d-flex justify-content-between align-items-center mb-1">
<span class="badge ${badgeColor} small" style="font-size:0.65rem; font-weight:bold;">${item.tipo}</span>
<span class="text-white-50 font-monospace" style="font-size:0.7rem;"><i class="bi bi-clock me-1"></i>${item.inicio} al ${item.fin.split(' ')[1]}</span>
</div>
<div class="small fw-bold text-white mb-1">${item.nombre}</div>
<div class="text-info opacity-75 small" style="font-size:0.7rem;"><i class="bi bi-briefcase me-1"></i>Proyecto: ${item.proyecto}</div>
`;
lista.appendChild(block);
});
} catch (e) {
cargando.classList.add('d-none');
lista.innerHTML = `<div class="text-center py-3 text-danger small"><i class="bi bi-exclamation-octagon me-1"></i> Error al conectar con el motor de agendas.</div>`;
}
}

function validarLimitesPadreHijo() {
try {
let hayErrores = false;
const wrappers = document.querySelectorAll('.subfase-group-wrapper');

function setInputError(input, isError) {
if (!input) return;
if (isError) {
input.style.setProperty('border', '2px solid #ef4444', 'important');
input.style.setProperty('background-color', 'rgba(239, 68, 68, 0.15)', 'important');
input.style.setProperty('color', '#ff6b6b', 'important');
} else {
input.style.removeProperty('border');
input.style.removeProperty('background-color');
input.style.removeProperty('color');
}
}

wrappers.forEach(wrapper => {
const sfRow = wrapper.querySelector('.subfase-row-container');
if (!sfRow) return;

const sfIniInput = sfRow.querySelector('.input-inicio');
const sfFinInput = sfRow.querySelector('.input-fin');
const sfHorasInput = sfRow.querySelector('.input-horas');

const sfIniDate = (sfIniInput && sfIniInput.value) ? new Date(sfIniInput.value) : null;
const sfFinDate = (sfFinInput && sfFinInput.value) ? new Date(sfFinInput.value) : null;
const sfHorasVal = (sfHorasInput && sfHorasInput.value) ? parseFloat(sfHorasInput.value) : 0;

let sumaHorasHijas = 0;
const tareas = wrapper.querySelectorAll('.tarea-row-container');

tareas.forEach(tRow => {
const tIniInput = tRow.querySelector('.input-inicio');
const tFinInput = tRow.querySelector('.input-fin');
const tHorasInput = tRow.querySelector('.input-horas');

const tIniDate = (tIniInput && tIniInput.value) ? new Date(tIniInput.value) : null;
const tFinDate = (tFinInput && tFinInput.value) ? new Date(tFinInput.value) : null;
const tHorasVal = (tHorasInput && tHorasInput.value) ? parseFloat(tHorasInput.value) : 0;

sumaHorasHijas += tHorasVal;
let errorFechas = false;

if (sfIniDate && tIniDate && tIniDate < sfIniDate) errorFechas = true;
if (sfFinDate && tFinDate && tFinDate > sfFinDate) errorFechas = true;

setInputError(tIniInput, errorFechas);
setInputError(tFinInput, errorFechas);
setInputError(tHorasInput, sumaHorasHijas > sfHorasVal);

if (sumaHorasHijas > sfHorasVal || errorFechas) hayErrores = true;
});

setInputError(sfHorasInput, sumaHorasHijas > sfHorasVal && tareas.length > 0);
});

const btnSubmit = document.getElementById('btnSubmit');
const btnIcon = document.getElementById('iconSubmit');
if (btnSubmit) {
if (hayErrores) {
btnSubmit.disabled = true;
btnSubmit.classList.replace('btn-warning', 'btn-danger');
if(btnIcon) btnIcon.className = 'bi bi-shield-fill-x me-1';
} else {
btnSubmit.disabled = false;
btnSubmit.classList.replace('btn-danger', 'btn-warning');
if(btnIcon) btnIcon.className = 'bi bi-save me-1';
}
}
} catch (error) {
console.error("Error en validación:", error);
}
}

function reindexAll() {
const wrappers = document.querySelectorAll('.subfase-group-wrapper');
wrappers.forEach((wrapper, sIdx) => {
const sfRow = wrapper.querySelector('.subfase-row-container');
if (sfRow) {
const inpId = sfRow.querySelector('.input-sf-id'); if(inpId) inpId.name = `Subfases[${sIdx}].Id`;
const selFase = sfRow.querySelector('.input-fasepadre'); if(selFase) selFase.name = `Subfases[${sIdx}].FasePadre`;
const inpNom = sfRow.querySelector('.input-nombre'); if(inpNom) inpNom.name = `Subfases[${sIdx}].Nombre`;
const inpIni = sfRow.querySelector('.input-inicio'); if(inpIni) inpIni.name = `Subfases[${sIdx}].FechaInicio`;
const inpFin = sfRow.querySelector('.input-fin'); if(inpFin) inpFin.name = `Subfases[${sIdx}].FechaFinEstimada`;
const inpHrs = sfRow.querySelector('.input-horas'); if(inpHrs) inpHrs.name = `Subfases[${sIdx}].HorasEstimadas`;
const selRes = sfRow.querySelector('.user-select'); if(selRes) selRes.name = `Subfases[${sIdx}].ResponsableId`;
}
const tRows = wrapper.querySelectorAll('.tarea-row-container');
tRows.forEach((tRow, tIdx) => {
const tId = tRow.querySelector('.input-tarea-id'); if(tId) tId.name = `Subfases[${sIdx}].Tareas[${tIdx}].Id`;
const tNom = tRow.querySelector('.input-nombre'); if(tNom) tNom.name = `Subfases[${sIdx}].Tareas[${tIdx}].Nombre`;
const tIni = tRow.querySelector('.input-inicio'); if(tIni) tIni.name = `Subfases[${sIdx}].Tareas[${tIdx}].FechaInicioPlanificada`;
const tFin = tRow.querySelector('.input-fin'); if(tFin) tFin.name = `Subfases[${sIdx}].Tareas[${tIdx}].FechaFinPlanificada`;
const tHrs = tRow.querySelector('.input-horas'); if(tHrs) tHrs.name = `Subfases[${sIdx}].Tareas[${tIdx}].HorasEstimadas`;
const tRes = tRow.querySelector('.user-select'); if(tRes) tRes.name = `Subfases[${sIdx}].Tareas[${tIdx}].UsuarioAsignadoId`;
});
});

validarLimitesPadreHijo();
}

