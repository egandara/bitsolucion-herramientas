           ESTRUCTURA LATERAL Y PANELES
           ============================================================ */
    .cal-sidebar-block {
        background-color: #111424 !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        border-radius: 10px;
        padding: 18px !important;
        margin-bottom: 16px;
    }

    .cal-sidebar-title {
        font-size: 0.8rem !important;
        font-weight: 700 !important;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #0dcaf0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding-bottom: 8px;
        margin-bottom: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-group-stacked {
        margin-bottom: 12px;
    }

        .form-group-stacked:last-child {
            margin-bottom: 0;
        }

        .form-group-stacked label {
            font-size: 0.72rem !important;
            color: rgba(255, 255, 255, 0.4) !important;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px !important;
            font-weight: bold;
        }

    .btn-auto-calcular {
        font-size: 0.65rem !important;
        padding: 2px 8px !important;
        border-radius: 6px !important;
        font-family: ui-monospace, monospace;
    }

    /* ============================================================
           GRID EXTENDIDO PARA SUBFASES Y TAREAS (WBS)
           ============================================================ */
    .subfase-group-wrapper {
        background-color: rgba(255, 255, 255, 0.01);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        padding: 14px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .subfase-row-container {
        display: grid !important;
        grid-template-columns: 1.5fr 3.5fr 1.5fr 0.8fr 1.5fr 2.5fr auto !important;
        gap: 12px !important;
        align-items: end !important;
        margin-bottom: 8px;
    }

    .tarea-row-container {
        display: grid !important;
        grid-template-columns: 3.5fr 1.5fr 0.8fr 1.5fr 2.5fr auto !important;
        gap: 12px !important;
        align-items: end !important;
        background-color: rgba(13, 202, 240, 0.03);
        border-left: 3px solid #0dcaf0;
        border-radius: 6px;
        padding: 10px 14px !important;
        margin-bottom: 8px;
        margin-left: 40px;
    }

    .form-group-grid {
        display: flex;
        flex-direction: column;
        width: 100% !important;
    }

        .form-group-grid label {
            font-size: 0.7rem !important;
            color: rgba(255, 255, 255, 0.4) !important;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px !important;
            white-space: nowrap;
        }

        .form-group-grid .form-control, .form-group-grid .form-select {
            width: 100% !important;
            padding: 6px 10px !important;
            font-size: 0.8rem !important;
            background-color: #171b2e !important;
            border: 1px solid rgba(255,255,255,0.08) !important;
            color: #f5f6fa !important;
            border-radius: 6px !important;
            text-overflow: ellipsis;
        }

    .input-horas {
        text-align: center;
    }

    .actions-group {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding-bottom: 4px;
    }

    .sticky-tray {
        position: sticky;
