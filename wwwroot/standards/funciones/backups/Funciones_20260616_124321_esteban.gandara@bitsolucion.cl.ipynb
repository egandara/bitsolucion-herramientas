        "#------------------------- Permite ejecutar query SQL mediante el sql_safe -------------------------\n",
        "def sqlsafe(query):\n",
        "  try:\n",
        "    print (\u0022sql_safe: query -\u003E \u0022 \u002B query)\n",
        "    return spark.sql(query)\n",
        "  except Exception as e:\n",
        "    raise Exception(f\u0027{{\u0022coderror\u0022:\u002220001\u0022, \u0022msgerror\u0022:\u0022Error grave procesando consulta -\u003E {str(e)}\u0022}}\u0027)"
      ]
